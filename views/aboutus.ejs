<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Sobre Nós | FieldAcademy</title>
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body class="bg-gray-50">
    <!-- Header -->
    <%- include('./partials/header') %>

    <!-- Hero Section -->
    <section class="relative">
      <div class="w-full h-[300px] md:h-[400px] overflow-hidden">
        <img
          src="https://images.unsplash.com/photo-1558051815-0f18e64e6280?ixlib=rb-4.0.3&ixid=MnwxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8&auto=format&fit=crop&w=1170&q=80"
          alt="Tecnologia no agronegócio"
          class="w-full h-full object-cover brightness-75"
        />
        <div class="absolute inset-0 bg-black bg-opacity-50"></div>
        <div
          class="absolute inset-0 flex flex-col justify-center items-center text-white px-4 md:px-0"
        >
          <h1 class="text-3xl md:text-5xl font-bold text-center mb-4">
            Sobre o FieldAcademy
          </h1>
          <p class="text-lg md:text-xl text-center max-w-3xl">
            Conheça nossa missão de transformar a capacitação técnica no
            agronegócio
          </p>
        </div>
      </div>
    </section>

    <!-- Quem Somos -->
    <section class="py-16 px-4 md:px-8 lg:px-16">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="text-3xl md:text-4xl font-bold mb-4">Quem Somos</h2>
          <div class="w-24 h-1 bg-secondaryGreen mx-auto mb-6"></div>
        </div>

        <div class="grid md:grid-cols-2 gap-12 items-center">
          <div>
            <p class="text-gray-700 text-lg mb-6 leading-relaxed">
              O FieldAcademy é uma plataforma inovadora dedicada à capacitação
              técnica no agronegócio, criada para elevar o conhecimento e a
              eficiência dos PTDs (Promotores Técnicos Digitais) da AgroBayer.
            </p>
            <p class="text-gray-700 text-lg mb-6 leading-relaxed">
              Com um sistema de aprendizado estruturado, personalizado e
              acessível, buscamos solucionar os desafios da alta rotatividade e
              das lacunas de treinamento enfrentadas por esses profissionais que
              são essenciais para o sucesso das tecnologias digitais no campo.
            </p>
            <p class="text-gray-700 text-lg leading-relaxed">
              Nosso ambiente de aprendizado intuitivo se destaca pelo uso da
              gamificação, que torna o treinamento mais dinâmico e envolvente.
              Outro diferencial essencial é o acesso offline, permitindo que os
              profissionais consultem conteúdos mesmo em áreas remotas com pouca
              conectividade.
            </p>
          </div>
          <div>
            <img
              src="https://images.unsplash.com/photo-1605000797499-95a51c5269ae?ixlib=rb-4.0.3&ixid=MnwxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8&auto=format&fit=crop&w=1171&q=80"
              alt="Tecnologia no campo"
              class="rounded-lg shadow-lg"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Nossa Missão -->
    <section class="py-16 px-4 md:px-8 lg:px-16 bg-gray-50">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="text-3xl md:text-4xl font-bold mb-4">Nossa Missão</h2>
          <div class="w-24 h-1 bg-secondaryGreen mx-auto mb-6"></div>
        </div>

        <div class="grid md:grid-cols-3 gap-8">
          <div
            class="bg-white p-6 rounded-lg shadow-md hover:shadow-lg transition-all"
          >
            <div
              class="w-16 h-16 bg-secondaryGreen/10 rounded-full flex items-center justify-center mb-4"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-8 w-8 text-secondaryGreen"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M13 10V3L4 14h7v7l9-11h-7z"
                />
              </svg>
            </div>
            <h3 class="text-xl font-bold mb-3">Capacitar</h3>
            <p class="text-gray-600">
              Fornecer treinamento técnico de excelência para promotores
              digitais, garantindo domínio completo das ferramentas FieldView e
              autonomia em campo.
            </p>
          </div>

          <div
            class="bg-white p-6 rounded-lg shadow-md hover:shadow-lg transition-all"
          >
            <div
              class="w-16 h-16 bg-secondaryGreen/10 rounded-full flex items-center justify-center mb-4"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-8 w-8 text-secondaryGreen"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"
                />
              </svg>
            </div>
            <h3 class="text-xl font-bold mb-3">Reduzir Rotatividade</h3>
            <p class="text-gray-600">
              Melhorar a retenção de talentos através de uma jornada clara de
              desenvolvimento profissional e reconhecimento por meio de
              certificações.
            </p>
          </div>

          <div
            class="bg-white p-6 rounded-lg shadow-md hover:shadow-lg transition-all"
          >
            <div
              class="w-16 h-16 bg-secondaryGreen/10 rounded-full flex items-center justify-center mb-4"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-8 w-8 text-secondaryGreen"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
                />
              </svg>
            </div>
            <h3 class="text-xl font-bold mb-3">Padronizar Atendimento</h3>
            <p class="text-gray-600">
              Criar um padrão de excelência no atendimento ao produtor rural,
              garantindo que todos os PTDs ofereçam o mesmo nível de suporte
              técnico em campo.
            </p>
          </div>
        </div>
      </div>
    </section>

