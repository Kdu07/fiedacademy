<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Gestão de Conteúdo | FieldAcademy</title>
    <link rel="stylesheet" href="/css/style.css" />
    <script src="https://cdn.tailwindcss.com"></script>
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    />
  </head>
  <body class="flex flex-col min-h-screen bg-gray-50">
    <!-- Header -->
    <%- include('./partials/header') %>

    <!-- Conteúdo do Dashboard -->
    <div class="container mx-auto px-4 py-8">
      <h1
        class="text-3xl font-bold text-gray-800 mb-6 pb-2 border-b border-gray-200"
      >
        Gestão de Conteúdo
      </h1>

      <!-- Layout Principal do Dashboard -->
      <div class="flex flex-col md:flex-row gap-6">        <!-- Barra Lateral Esquerda - Filtros e Estatísticas -->
        <div class="w-full md:w-1/4">
          <!-- Estatísticas de Conteúdo -->
          <div class="bg-white rounded-lg shadow-md p-5 mb-6">
            <div class="space-y-4">
              <!-- Total de Módulos -->
              <div class="bg-blue-50 p-3 rounded-lg">
                <div class="flex items-center">
                  <div class="bg-blue-100 p-3 rounded-full mr-3">
                    <i class="fas fa-book text-blue-600"></i>
                  </div>
                  <div>
                    <p class="text-sm text-gray-600">Total de Conteúdos</p>
                    <p class="text-xl font-bold text-gray-800">
                      <%= allContents ? allContents.length : 0 %>
                    </p>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Filtros e Ordenação -->
          <form class="bg-white rounded-lg shadow-md p-5 mb-6" action="/contentDashboard" method="GET">
            <h3 class="text-lg font-semibold text-gray-800 mb-4">Filtros</h3>
            
            <!-- Seleção de Tipo de Conteúdo -->
            <div class="mb-4">
              <label class="block text-sm font-medium text-gray-700 mb-2">Exibir:</label>
              <div class="flex bg-gray-100 rounded-lg p-1">
                <button type="button" class="flex-1 py-2 px-3 text-sm font-medium rounded-md bg-secondaryGreen text-white focus:outline-none" data-view="lessons">
                  Lições
                </button>
                <button type="button" class="flex-1 py-2 px-3 text-sm font-medium rounded-md text-gray-700 hover:bg-gray-200 focus:outline-none" data-view="modules">
                  Módulos
                </button>
                <button type="button" class="flex-1 py-2 px-3 text-sm font-medium rounded-md text-gray-700 hover:bg-gray-200 focus:outline-none" data-view="paths">
                  Trilhas
                </button>
              </div>
              <input type="hidden" name="viewType" id="viewType" value="lessons">
            </div>

            <!-- Ordenação -->
            <div class="mb-4">
              <label class="block text-sm font-medium text-gray-700 mb-2">Ordenar por:</label>
              <select class="w-full p-2 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent" name="order">
                <option value="recent" <%= typeof order !== 'undefined' && order === 'recent' ? 'selected' : '' %>>Mais recentes</option>
                <option value="title_asc" <%= typeof order !== 'undefined' && order === 'title_asc' ? 'selected' : '' %>>Título (A-Z)</option>
                <option value="title_desc" <%= typeof order !== 'undefined' && order === 'title_desc' ? 'selected' : '' %>>Título (Z-A)</option>
                <option value="module" <%= typeof order !== 'undefined' && order === 'module' ? 'selected' : '' %>>Por módulo</option>
              </select>
            </div>
            
            <!-- Filtro por Módulos -->
            <div class="mb-4">
              <label class="block text-sm font-medium text-gray-700 mb-2">Filtrar por Módulo:</label>
              <select class="w-full p-2 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent" name="moduleFilter">
                <option value="">Todos os módulos</option>
                <% 
                  // Create a Set of unique module IDs and titles
                  let modules = new Set();
                  if (allContents && allContents.length > 0) {
                    allContents.forEach(content => {
                      if (content.module_id && content.module_title) {
                        modules.add(JSON.stringify({id: content.module_id, title: content.module_title}));
                      }
                    });
                  }
                  
                  // Convert to array and sort by title
                  let moduleArray = Array.from(modules).map(m => JSON.parse(m));
                  moduleArray.sort((a, b) => a.title.localeCompare(b.title));
                  
                  moduleArray.forEach(module => {
                %>
                <option value="<%= module.id %>" <%= typeof moduleFilter !== 'undefined' && parseInt(moduleFilter) === module.id ? 'selected' : '' %>>
                  <%= module.title %>
                </option>
                <% }); %>
              </select>
            </div>
            
            <!-- Filtro por Categoria -->
            <div class="mb-4">
              <label class="block text-sm font-medium text-gray-700 mb-2">Filtrar por Categoria:</label>
              <div class="space-y-2 max-h-48 overflow-y-auto pr-2">
                <% 
                  // Create a Set of unique categories
                  let categories = new Set();
                  if (allContents && allContents.length > 0) {
                    allContents.forEach(content => {
                      if (content.category) {
                        categories.add(content.category);
                      }
                    });
                  }
                  
                  // Convert to array and sort
                  let categoryArray = Array.from(categories).sort();
                  
                  categoryArray.forEach(category => {
                %>
                <div class="flex items-center">
                  <input 
                    type="checkbox" 
                    id="category-<%= category.replace(/\s+/g, '-').toLowerCase() %>" 
                    name="categories[]" 
                    value="<%= category %>" 
                    class="h-4 w-4 text-blue-600 rounded border-gray-300 focus:ring-blue-500"
                    <%= typeof selectedCategories !== 'undefined' && selectedCategories.includes(category) ? 'checked' : '' %>
                  >
                  <label for="category-<%= category.replace(/\s+/g, '-').toLowerCase() %>" class="ml-2 block text-sm text-gray-700">
                    <%= category %>
                  </label>
                </div>
                <% }); %>
              </div>
            </div>

            <!-- Botão para Aplicar Filtros -->
            <button class="w-full bg-blue-500 hover:bg-blue-600 text-white font-semibold py-2 px-4 rounded-md transition duration-300 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2" type="submit">
              Aplicar Filtros
            </button>
          </form>        </div>

        <!-- Área de Conteúdo à Direita - Pesquisa e Cartões de Conteúdo -->
        <div class="w-full md:w-3/4">          <!-- Barra de Pesquisa e Botão Adicionar -->
          <div class="flex flex-col md:flex-row items-center justify-between gap-4 mb-6">
            <div class="relative flex-grow w-full">
              <input
                type="text"
                id="contentSearchInput"
                placeholder="Pesquisar conteúdos..."
                class="w-full pl-10 pr-4 py-2 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
              />
              <div class="absolute left-3 top-2.5 text-gray-400">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="h-5 w-5"
                  viewBox="0 0 20 20"
                  fill="currentColor"
                >
                  <path
                    fill-rule="evenodd"
                    d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z"
                    clip-rule="evenodd"
                  />
                </svg>
              </div>
            </div>
            
            <!-- Botão para Adicionar Novo Conteúdo -->
            <a
              href="/content/new"
              class="w-full md:w-auto whitespace-nowrap bg-green-500 hover:bg-green-600 text-white text-center font-semibold py-2 px-4 rounded-md transition duration-300 focus:outline-none focus:ring-2 focus:ring-green-500 focus:ring-offset-2 flex items-center justify-center"
            >
              <i class="fas fa-plus mr-2"></i> Adicionar Novo Conteúdo
            </a>
          </div>

          <!-- Grade de Cartões de Conteúdo -->
          <div
            id="contentCardsContainer"
            class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6"
          >
            <% if (allContents && allContents.length > 0) { %> <%
            allContents.forEach(content => { %>
            <div
              class="content-card bg-white rounded-lg shadow-md overflow-hidden hover:shadow-lg transition-transform hover:-translate-y-1"
              data-title="<%= content.title ? content.title.toLowerCase() : '' %>"
              data-module="<%= content.id_module ? content.id_module : '' %>"
              data-type="<%= content.video_path !== null ? 'video' : 'doc' %>"
            >
              <a
                class="relative"
                href="/content/edit/<%= content.id %>"
                aria-label="Editar <%= content.title || 'conteúdo' %>"
              >
                <% if
                (content.video_path) { %> <% let videoId; if
                (content.video_path.includes('youtube.com/watch?v=')) { videoId
                = content.video_path.split('v=')[1]; const ampersandPosition =
                videoId.indexOf('&'); if (ampersandPosition !== -1) { videoId =
                videoId.substring(0, ampersandPosition); } } else if
                (content.video_path.includes('youtu.be/')) { videoId =
                content.video_path.split('youtu.be/')[1]; const
                questionMarkPosition = videoId.indexOf('?'); if
                (questionMarkPosition !== -1) { videoId = videoId.substring(0,
                questionMarkPosition); } } %>
                <div class="relative w-full h-40">
                  <img
                    src="https://img.youtube.com/vi/<%= videoId %>/hqdefault.jpg"
                    alt="<%= content.title %> thumbnail"
                    class="w-full h-40 object-cover"
                    onerror="this.onerror=null; this.src='https://img.youtube.com/vi/<%= videoId %>/mqdefault.jpg';"
                  />
                </div>
                <% } else { %>
                <div
                  class="w-full h-40 bg-gray-200 flex items-center justify-center"
                >
                  <% if (content.video_path) { %>
                  <i class="fas fa-video text-gray-400 text-4xl"></i>
                  <% } else if (content.doc_path) { %>
                  <i class="fas fa-file-alt text-gray-400 text-4xl"></i>
                  <% } else { %>
                  <i class="fas fa-file text-gray-400 text-4xl"></i>
                  <% } %>
                </div>
                <% } %>

                <!-- Badge para conteúdo destacado -->
                <% if (content.highlight) { %>
                <div
                  class="absolute top-2 right-2 bg-amber-500 text-white text-xs font-bold px-2 py-1 rounded-md"
                >
                  <i class="fas fa-star mr-1"></i> Destacado
                </div>
                <% } %>
              </a>

              <div class="p-4">
                <h3
                  class="text-lg font-semibold text-gray-800 mb-2 line-clamp-2"
                >
                  <%= content.title || `Conteúdo #${content.id}` %>
                </h3>

                <p class="text-sm text-gray-600 mb-3 line-clamp-2">
                  <%= 'Ultima atualização: '+content.last_update.toLocaleDateString('pt-BR') || 'Sem descrição disponível' %>
                </p>

                <div
                  class="flex justify-between items-center pt-3 border-t border-gray-100"
                >
                  <span class="text-sm text-gray-500">
                    <i class="fas fa-layer-group mr-1"></i>
                    <%= content.module_title %>
                  </span>

                  <div class="flex space-x-2">
                    <button
                      onclick="confirmDelete('<%= content.id %>')"
                      class="text-red-500 hover:text-red-700"
                    >
                      <i class="fas fa-trash-alt"></i>
                    </button>
                  </div>
                </div>
              </div>
            </div>
            <% }); %> <% } else { %>
            <div class="col-span-full py-12 text-center text-gray-500">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-16 w-16 mx-auto text-gray-400 mb-4"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"
                />
              </svg>
              <p class="text-xl font-medium">Nenhum conteúdo encontrado</p>
              <p class="mt-2">Comece a adicionar conteúdo ao sistema.</p>
              <a
                href="/content/new"
                class="inline-block mt-4 px-4 py-2 bg-green-500 text-white font-medium rounded-md hover:bg-green-600 transition-colors"
              >
                <i class="fas fa-plus mr-2"></i> Adicionar Conteúdo
              </a>
            </div>
            <% } %>
          </div>
        </div>
      </div>
    </div>
    <!-- Modal de Confirmação de Exclusão -->
    <div
      id="deleteModal"
      class="fixed inset-0 bg-black bg-opacity-50 z-50 hidden"
    >
      <div class="flex items-center justify-center h-full w-full">
        <div class="bg-white rounded-lg p-6 max-w-sm mx-4">
          <h3 class="text-lg font-bold text-gray-900 mb-4">
            Confirmar Exclusão
          </h3>
          <p class="text-gray-700 mb-6">
            Tem certeza que deseja excluir este conteúdo? Esta ação não pode ser
            desfeita.
          </p>
          <div class="flex justify-end space-x-3">
            <button
              onclick="closeDeleteModal()"
              class="px-4 py-2 bg-gray-200 text-gray-800 rounded-md hover:bg-gray-300 transition-colors"
            >
              Cancelar
            </button>
            <form id="deleteForm" method="POST" action="">
              <button
                type="submit"
                class="px-4 py-2 bg-red-500 text-white rounded-md hover:bg-red-600 transition-colors"
              >
                Excluir
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>

    <!-- Footer -->
    <%- include('./partials/footer') %>    <!-- Scripts -->
    <script>
      // Filtro por tipo de conteúdo (Lições, Módulos, Trilhas)
      document.addEventListener("DOMContentLoaded", function() {
        // Botões de tipo de conteúdo
        const viewButtons = document.querySelectorAll('[data-view]');
        const viewTypeInput = document.getElementById('viewType');
        
        // Adiciona evento de clique para cada botão
        viewButtons.forEach(button => {
          button.addEventListener('click', function() {
            // Remove a classe ativa de todos os botões
            viewButtons.forEach(btn => {
              btn.classList.remove('bg-secondaryGreen', 'text-white');
              btn.classList.add('text-gray-700', 'hover:bg-gray-200');
            });
            
            // Adiciona a classe ativa ao botão clicado
            this.classList.remove('text-gray-700', 'hover:bg-gray-200');
            this.classList.add('bg-secondaryGreen', 'text-white');
            
            // Atualiza o input hidden com o valor do tipo selecionado
            viewTypeInput.value = this.getAttribute('data-view');
          });
        });
      });
      
      // Pesquisa de conteúdo
      document.addEventListener("DOMContentLoaded", function () {
        const searchInput = document.getElementById("contentSearchInput");
        const contentCards = document.querySelectorAll(".content-card");
        const contentCardsContainer = document.getElementById(
          "contentCardsContainer"
        );
        let noResultsElement = null;

        searchInput.addEventListener("input", function () {
          const searchTerm = this.value.toLowerCase().trim();
          let hasVisibleCards = false;

          // Remove any existing "no results" message
          if (noResultsElement) {
            noResultsElement.remove();
            noResultsElement = null;
          }

          contentCards.forEach((card) => {
            const title = card.getAttribute("data-title");
            const module = card.getAttribute("data-module");
            const type = card.getAttribute("data-type");

            // Check if the card matches the search term
            const isMatch =
              title.includes(searchTerm) ||
              module.includes(searchTerm) ||
              type.includes(searchTerm);

            // Show or hide the card based on the search
            if (isMatch) {
              card.style.display = "";
              hasVisibleCards = true;
            } else {
              card.style.display = "none";
            }
          });

          // Show "no results" message if no cards are visible
          if (!hasVisibleCards && searchTerm) {
            noResultsElement = document.createElement("div");
            noResultsElement.className =
              "col-span-full py-8 text-center text-gray-500";
            noResultsElement.innerHTML = `
              <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 mx-auto text-gray-400 mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M12 14h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <p class="text-lg font-medium">Nenhum conteúdo encontrado</p>
              <p class="mt-1">Tente outro termo de busca.</p>
            `;
            contentCardsContainer.appendChild(noResultsElement);
          }
        });

        // Clear search when the input is cleared
        searchInput.addEventListener("search", function () {
          if (this.value === "") {
            contentCards.forEach((card) => {
              card.style.display = "";
            });

            if (noResultsElement) {
              noResultsElement.remove();
              noResultsElement = null;
            }
          }
        });
      });

      // Funções para o modal de exclusão
      function confirmDelete(contentId) {
        const modal = document.getElementById("deleteModal");
        const form = document.getElementById("deleteForm");

        // Set the form action with the content ID
        form.action = `/content/delete/${contentId}`;

        // Show the modal
        modal.classList.remove("hidden");
      }

      function closeDeleteModal() {
        const modal = document.getElementById("deleteModal");
        modal.classList.add("hidden");
      }

      // Close modal when clicking outside
      document
        .getElementById("deleteModal")
        .addEventListener("click", function (e) {
          if (e.target === this) {
            closeDeleteModal();
          }
        });
    </script>
  </body>
</html>
