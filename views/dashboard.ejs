<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link href="/css/style.css" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com"></script>
    <title>Dashboard</title>
  </head>
  <body class="bg-gray-100">
    <!-- Header -->
    <%- include('./partials/header') %>

    <!-- Dashboard Content -->
    <div class="container mx-auto px-4 py-8">
      <h1
        class="text-3xl font-bold text-gray-800 mb-6 pb-2 border-b border-gray-200"
      >
        Dashboard dos usários 
      </h1>

      <!-- User Cards Grid -->
      <div
        class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6"
      >
        <% ptd_users.forEach(ptd_user => { %>
        <a
          href="/profile/<%= ptd_user.id %>"
          class="block transition-transform hover:-translate-y-1"
        >
          <div
            class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-lg"
          >
            <div class="p-5">
              <div class="flex items-center mb-4">
                <% if (ptd_user.profile_photo_path) { %>
                <img
                  src="<%= ptd_user.profile_photo_path %>"
                  alt="<%= ptd_user.name %>'s profile"
                  class="w-16 h-16 rounded-full object-cover mr-3"
                />
                <% } else { %>
                <div
                  class="w-16 h-16 rounded-full bg-gray-300 flex items-center justify-center mr-3"
                >
                  <span class="text-xl font-semibold text-gray-600"
                    ><%= ptd_user.name.charAt(0).toUpperCase() %></span
                  >
                </div>
                <% } %>
                <div>
                  <h3 class="text-lg font-semibold text-gray-800">
                    <%= ptd_user.name %>
                  </h3>
                  <p class="text-gray-500 text-sm"><%= ptd_user.email %></p>
                </div>
              </div>

              <div class="flex items-center mb-3">
                <span
                  class="px-2 py-1 text-xs font-semibold bg-blue-100 text-blue-800 rounded-full"
                >
                  <%= ptd_user.region %>
                </span>
              </div>

              <div class="grid grid-cols-2 gap-2 pt-3 border-t border-gray-100">
                <div class="text-center">
                  <p class="text-lg font-bold text-gray-800">
                    <%= ptd_user.score %>
                  </p>
                  <p class="text-xs text-gray-500">Pontuação</p>
                </div>
                <div class="text-center">
                  <p class="text-sm font-medium text-gray-800">
                    <%= ptd_user.last_login ? new
                    Date(ptd_user.last_login).toLocaleDateString() : 'Nunca' %>
                  </p>
                  <p class="text-xs text-gray-500">Ultimo login</p>
                </div>
              </div>
            </div>
          </div>
        </a>
        <% }); %>
      </div>
    </div>

    <!-- Footer -->
    <%- include('./partials/footer') %>
  </body>
</html>
