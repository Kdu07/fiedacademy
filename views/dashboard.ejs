<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link href="/css/style.css" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com"></script>
    <title>Dashboard</title>
  </head>
  <body class="bg-gray-100">
    <!-- Cabeçalho -->
    <%- include('./partials/header') %>

    <!-- Conteúdo do Dashboard -->
    <div class="container mx-auto px-4 py-8">
      <h1
        class="text-3xl font-bold text-gray-800 mb-6 pb-2 border-b border-gray-200"
      >
        Dashboard dos usários
      </h1>

      <!-- Layout Principal do Dashboard -->
      <div class="flex flex-col md:flex-row gap-6">
        <!-- Barra Lateral Esquerda - Filtros e Estatísticas -->
        <div class="w-full md:w-1/4">
          <!-- Progresso Circular da Pontuação Média -->
          <div class="bg-white rounded-lg shadow-md p-5 mb-6">
            <h3 class="text-lg font-semibold text-gray-800 mb-4 text-center">
              Pontuação Média
            </h3>

            <div class="flex justify-center">
              <div class="relative h-36 w-36">
                <!-- Círculo de Fundo -->
                <svg class="h-full w-full" viewBox="0 0 100 100">
                  <circle
                    cx="50"
                    cy="50"
                    r="45"
                    fill="none"
                    stroke="#e6e6e6"
                    stroke-width="8"
                  />

                  <!-- Círculo de Progresso -->
                  <circle
                    cx="50"
                    cy="50"
                    r="45"
                    fill="none"
                    stroke="#3b82f6"
                    stroke-width="8"
                    stroke-dasharray="283"
                    stroke-dashoffset="<%= dashOffset %>"
                    transform="rotate(-90 50 50)"
                    stroke-linecap="round"
                  />
                </svg>

                <!-- Texto da Pontuação -->
                <div class="absolute inset-0 flex items-center justify-center">
                  <span class="text-3xl font-bold text-gray-800"
                    ><%= averageScore %></span
                  >
                </div>
              </div>
            </div>

            <div class="text-center mt-4">
              <p class="text-sm text-gray-600">
                Baseado em <%= ptd_users.length %> usuários
              </p>
            </div>
          </div>

          <!-- Opções de Filtro -->
          <form
            class="bg-white rounded-lg shadow-md p-5 mb-6"
            action="/dashboard"
            method="GET"
          >
            <h3 class="text-lg font-semibold text-gray-800 mb-4">Filtros</h3>

            <!-- Ordenação -->
            <label class="block text-sm font-medium text-gray-700 mb-2"
              >Ordenar por:</label
            >

            <select
              class="w-full p-2 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent mb-6"
              name="order"
            >
              <% if(order == '') { %>
              <option value="" disabled selected>Ordenar por</option>
              <% } else { %>
              <option value="" disabled>Ordenar por</option>
              <% } %> <% if(order == 'name_asc') { %>
              <option value="name_asc" selected>Nome (A-Z)</option>
              <% } else { %>
              <option value="name_asc">Nome (A-Z)</option>
              <% } %> <% if(order == 'name_desc') { %>
              <option value="name_desc" selected>Nome (Z-A)</option>
              <% } else { %>
              <option value="name_desc">Nome (Z-A)</option>
              <% } %> <% if(order == 'score_high') { %>
              <option value="score_high" selected>Maior Pontuação</option>
              <% } else { %>
              <option value="score_high">Maior Pontuação</option>
              <% } %> <% if(order == 'score_low') { %>
              <option value="score_low" selected>Menor Pontuação</option>
              <% } else { %>
              <option value="score_low">Menor Pontuação</option>
              <% } %> <% if(order == 'recent_login') { %>
              <option value="recent_login" selected>Login Recente</option>
              <% } else { %>
              <option value="recent_login">Login Recente</option>
              <% } %> <% if(order == 'region') { %>
              <option value="region" selected>Região</option>
              <% } else { %>
              <option value="region">Região</option>
              <% } %>
            </select>

            <!-- Filtros por Região -->
            <div class="mb-5">
              <h4
                class="text-sm font-semibold text-gray-700 mb-3 border-b pb-1"
              >
                Região
              </h4>
              <div class="space-y-2">
                <% let regionCounts = {}; all_Users.forEach(user => {
                if(user.region) { regionCounts[user.region] =
                (regionCounts[user.region] || 0) + 1; } });
                Object.keys(regionCounts).forEach(region => { %>
                <div class="flex items-center">
                  <input type="checkbox" id="region-<%= region %>"
                  name="regions[]" value="<%= region %>" class="h-4 w-4
                  text-blue-600 rounded border-gray-300 focus:ring-blue-500" <%=
                  selectedRegions.includes(region) ? 'checked' : '' %> />
                  <label
                    for="region-<%= region %>"
                    class="ml-2 block text-sm text-gray-700"
                  >
                    <%= region %> (<%= regionCounts[region] %>)
                  </label>
                </div>
                <% }) %>
              </div>
            </div>

            <!-- Botão para Aplicar Filtros -->
            <button
              class="w-full bg-blue-500 hover:bg-blue-600 text-white font-semibold py-2 px-4 rounded-md transition duration-300 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2"
              type="submit"
            >
              Aplicar Filtros
            </button>
          </form>
        </div>

        <!-- Área de Conteúdo à Direita - Pesquisa e Cartões de Usuários -->
        <div class="w-full md:w-3/4">
          <!-- Barra de Pesquisa -->
          <div class="mb-6">
            <div class="relative">
              <input
                type="text"
                id="userSearchInput"
                placeholder="Pesquisar usuários..."
                class="w-full pl-10 pr-4 py-2 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
              />
              <div class="absolute left-3 top-2.5 text-gray-400">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="h-5 w-5"
                  viewBox="0 0 20 20"
                  fill="currentColor"
                >
                  <path
                    fill-rule="evenodd"
                    d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z"
                    clip-rule="evenodd"
                  />
                </svg>
              </div>
            </div>
          </div>
          <!-- Grade de Cartões de Usuários -->
          <div
            id="userCardsContainer"
            class="grid grid-cols-1 sm:grid-cols-1 lg:grid-cols-2 xl:grid-cols-3 gap-6"
          >
            <% ptd_users.forEach(ptd_user => { %>
            <a
              href="/profile/<%= ptd_user.id %>"
              class="user-card block transition-transform hover:-translate-y-1"
              data-name="<%= ptd_user.name.toLowerCase() %>"
              data-email="<%= ptd_user.email.toLowerCase() %>"
              data-region="<%= ptd_user.region ? ptd_user.region.toLowerCase() : '' %>"
            >
              <div
                class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-lg"
              >
                <div class="p-5">
                  <div class="flex items-center mb-4">
                    <% if (ptd_user.profile_photo_path) { %>
                    <img
                      src="<%= ptd_user.profile_photo_path %>"
                      alt="<%= ptd_user.name %>'s profile"
                      class="w-16 h-16 rounded-full object-cover mr-3"
                    />
                    <% } else { %>
                    <div
                      class="w-16 h-16 rounded-full bg-gray-300 flex items-center justify-center mr-3"
                    >
                      <span class="text-xl font-semibold text-gray-600"
                        ><%= ptd_user.name.charAt(0).toUpperCase() %></span
                      >
                    </div>
                    <% } %>
                    <div>
                      <h3 class="text-lg font-semibold text-gray-800">
                        <%= ptd_user.name %>
                      </h3>
                      <p class="text-gray-500 text-sm"><%= ptd_user.email %></p>
                    </div>
                  </div>

                  <div class="flex items-center mb-3">
                    <span
                      class="px-2 py-1 text-xs font-semibold bg-blue-100 text-blue-800 rounded-full"
                    >
                      <%= ptd_user.region %>
                    </span>
                  </div>

                  <div
                    class="grid grid-cols-2 gap-2 pt-3 border-t border-gray-100"
                  >
                    <div class="text-center">
                      <p class="text-lg font-bold text-gray-800">
                        <%= ptd_user.score %>
                      </p>
                      <p class="text-xs text-gray-500">Pontuação</p>
                    </div>
                    <div class="text-center">
                      <p class="text-sm font-medium text-gray-800">
                        <%= ptd_user.last_login ? new
                        Date(ptd_user.last_login).toLocaleDateString() : 'Nunca'
                        %>
                      </p>
                      <p class="text-xs text-gray-500">Ultimo login</p>
                    </div>
                  </div>
                </div>
              </div>
            </a>
            <% }); %>
          </div>
        </div>
      </div>
    </div>

    <!-- Rodapé -->
    <%- include('./partials/footer') %>

    <!-- Search Functionality -->
    <script>
      // Apenas vibes 😎
      document.addEventListener("DOMContentLoaded", function () {
        const searchInput = document.getElementById("userSearchInput");
        const userCards = document.querySelectorAll(".user-card");
        const userCardsContainer =
          document.getElementById("userCardsContainer");
        let noResultsElement = null;

        searchInput.addEventListener("input", function () {
          const searchTerm = this.value.toLowerCase().trim();
          let hasVisibleCards = false;

          // Remove any existing "no results" message
          if (noResultsElement) {
            noResultsElement.remove();
            noResultsElement = null;
          }

          userCards.forEach((card) => {
            const userName = card.getAttribute("data-name");
            const userEmail = card.getAttribute("data-email");
            const userRegion = card.getAttribute("data-region");

            // Check if the card matches the search term
            const isMatch =
              userName.includes(searchTerm) ||
              userEmail.includes(searchTerm) ||
              userRegion.includes(searchTerm);

            // Show or hide the card based on the search
            if (isMatch) {
              card.style.display = "";
              hasVisibleCards = true;
            } else {
              card.style.display = "none";
            }
          });

          // Show "no results" message if no cards are visible
          if (!hasVisibleCards && searchTerm) {
            noResultsElement = document.createElement("div");
            noResultsElement.className =
              "col-span-full py-8 text-center text-gray-500";
            noResultsElement.innerHTML = `
          <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 mx-auto text-gray-400 mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M12 14h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <p class="text-lg font-medium">Nenhum usuário encontrado</p>
          <p class="mt-1">Tente outro termo de busca.</p>
        `;
            userCardsContainer.appendChild(noResultsElement);
          }
        });

        // Clear search when the input is cleared
        searchInput.addEventListener("search", function () {
          if (this.value === "") {
            userCards.forEach((card) => {
              card.style.display = "";
            });

            if (noResultsElement) {
              noResultsElement.remove();
              noResultsElement = null;
            }
          }
        });
      });
    </script>
  </body>
</html>
