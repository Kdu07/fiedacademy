<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link href="/css/style.css" rel="stylesheet" />
    <title>Dashboard</title>
  </head>
  <body>
    <!-- Header -->
    <%- include('./partials/header') %>

    <div class="flex flex-col w-4/6 mx-auto mt-8">
      <div class="w-full rounded-lg mt-4 mb-4">
        <form action="/dashboard/getUser" method="POST" class="relative">
          <input
            class="bg-white border-2 border-black w-full h-12 rounded-lg px-4 pr-16"
            type="text"
            placeholder="Pesquisa PTD"
            name="PTD"
            id="PTD"
            required
          />
          <button
            type="submit"
            class="bg-mainGreen absolute right-1 top-1 h-10 px-4 rounded-lg"
          >
            <p class="text-white">Buscar PTD</p>
          </button>
        </form>
      </div>
      <div class="flex flex-row">
        <div
          class="w-24 h-24 rounded-full border-2 border-black flex items-center justify-center mr-4 relative group hover:bg-gray-200 transition-colors duration-200"
        >
          <img
            src="<%= user.profile_photo_path ? user.profile_photo_path : '/images/Conta_Default.svg' %>"
            class="w-full h-full rounded-full"
            alt=""
          />
        </div>
        <div>
          <h1 class="text-3xl font-semibold"><%- user.name %></h1>
          <p><%- user.email %></p>
          <p><%- user.region %></p>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-4 mt-8">
        <div
          class="flex flex-col items-center justify-center bg-gray-100 rounded-lg"
        >
          <p>Último acesso</p>
          <p class="text-xl font-semibold"><%- lastLogin %></p>
        </div>
        <div
          class="flex flex-col items-center justify-center bg-gray-100 rounded-lg"
        >
          <p>Último módulo</p>
          <p class="text-xl font-semibold">Modulo 1</p>
        </div>
        <div
          class="flex flex-col items-center justify-center bg-gray-100 rounded-lg"
        >
          <p>Média</p>
          <p class="text-xl font-semibold"><%- user.score %></p>
        </div>
        <div
          class="flex flex-col items-center justify-center bg-gray-100 rounded-lg"
        >
          <p>Posição no rank</p>
          <% if(userRank === 1) { %>
          <p class="text-xl font-bold"><%- userRank %>🏆</p>
          <% } else { %>
          <p class="text-xl font-semibold"><%- userRank %></p>
          <% } %>
        </div>
      </div>
      <div class="grid grid-cols-1 gap-6 bg-gray-100 rounded-lg mt-8 p-4">
        <h1 class="text-3xl mb-4">Trilhas</h1>
        <% progress.forEach((trilha) => { %>
        <!-- Trilha -->
        <div class="flex flex-row items-center justify-between">
          <p class="me-4 text-xl w-1/6">
            <%- trilha.path_title %> (<%- trilha.progress_percentage %>%)
          </p>
          <div class="w-4/6 h-4 bg-gray-100 rounded-full">
            <div
              class="h-full bg-cyan-400 rounded-full"
              style="width: <%- trilha.progress_percentage %>%"
            ></div>
          </div>
          <a href="/dashboard">
            <img src="/icons/download.svg" alt="" />
          </a>
        </div>
        <% }) %>
      </div>
      <div
        class="flex flex-col bg-gray-100 rounded-lg mt-8 p-4 justify-items-end"
      >
        <h1 class="text-3xl mb-4">Média dos Módulos</h1>
        <% if(moduleScores.length === 0) { %>
        <p class="text-center text-gray-500">Nenhum módulo concluído</p>
        <% } else {%>
        <div
          class="w-5/6 flex flex-row justify-between border-b-2 border-black self-end"
        >
          <p>0</p>
          <p>1</p>
          <p>2</p>
          <p>3</p>
          <p>4</p>
          <p>5</p>
          <p>6</p>
          <p>7</p>
          <p>8</p>
          <p>9</p>
          <p>10</p>
        </div>
        <div class="flex flex-col border-black border-e-2">
          <% moduleScores.forEach((module) => { %>
          <!-- Trilha individual -->
          <div class="flex flex-row items-center">
            <div class="w-1/6 border-e-2 border-black">
              <p><%- module.module_title %> [<%- module.user_score %>%]</p>
            </div>
            <div class="w-5/6">
              <div
                class="bg-mainGreen h-4"
                style="width: <%- module.user_score %>%"
              ></div>
            </div>
          </div>
          <% }) %> <% } %>
        </div>
      </div>
    </div>

    <!-- Footer -->
    <%- include('./partials/footer') %>
  </body>
</html>
