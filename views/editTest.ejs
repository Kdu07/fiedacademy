<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= test && test.id ? 'Editar' : 'Nova' %> Prova | FieldAcademy</title>
    <link rel="stylesheet" href="/css/style.css" />
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  </head>
  <body class="bg-gray-50">
    <!-- Header -->
    <%- include('./partials/header') %>

    <div class="mt-8">
      <!-- Back button and title -->
      <div class="flex items-center mb-6 ms-10">
        <a href="/contentDashboard/tests" class="text-gray-600 hover:text-gray-900 mr-4">
          <i class="fas fa-arrow-left"></i> 
        </a>
        <h1 class="text-2xl font-bold text-gray-800">
          <%= test && test.id ? 'Editar Prova' : 'Criar Nova Prova' %>
        </h1>
      </div>


      <form 
        id="testForm"
        action="<%= test && test.id ? '/test/update/' + test.id : '/test/create' %>"
        method="POST"
        class="flex flex-row justify-between mb-16"
        data-questions="<%= test && test.questions ? JSON.stringify(test.questions) : '[]' %>"
      >
        <input type="hidden" name="_method" value="<%= test && test.id ? 'PUT' : 'POST' %>">
        <input type="hidden" id="questionsData" name="questions" value="">
        
        <!-- Test info sidebar -->
        <div
          class="bg-white mt-8 ms-8 w-3/12 rounded-xl flex flex-col p-6 shadow-md border border-gray-100 h-fit sticky top-28"
        >
          <h2
            class="text-secondaryGreen font-bold text-xl mb-4 text-center border-b border-gray-100 pb-2"
          >
            Informações da Prova
          </h2>
          <div class="w-full space-y-4">
            <!-- Test Title -->
            <div class="flex flex-col">
              <label class="text-gray-500 text-sm">Título da Prova*</label>
              <input 
                type="text" 
                name="title" 
                value="<%= test && test.title ? test.title : '' %>" 
                class="font-medium px-3 py-2 border border-gray-200 rounded focus:outline-none focus:ring-2 focus:ring-secondaryGreen"
                placeholder="Título da prova"
                required
              />
            </div>

            <!-- Description -->
            <div class="flex flex-col">
              <label class="text-gray-500 text-sm">Descrição</label>
              <textarea 
                name="description" 
                rows="3"
                class="font-medium px-3 py-2 border border-gray-200 rounded focus:outline-none focus:ring-2 focus:ring-secondaryGreen"
                placeholder="Descreva brevemente esta prova..."
              ><%= test && test.description ? test.description : '' %></textarea>
            </div>

            <!-- Time Estimate -->
            <div class="flex flex-col">
              <label class="text-gray-500 text-sm">Tempo Estimado*</label>
              <input 
                type="text" 
                name="estimated_time" 
                value="<%= test && test.estimated_time ? test.estimated_time : '30' %>"
                min="1"
                class="font-medium px-3 py-2 border border-gray-200 rounded focus:outline-none focus:ring-2 focus:ring-secondaryGreen"
                required
              />
            </div>
            
            <!-- Module (placeholder - you'll need to pass modules data) -->
            <div class="flex flex-col">
              <label class="text-gray-500 text-sm">Módulo</label>
              <p><%= test.module_name %></p>
            </div>


            <!-- Pontuação Total (calculada via JS) -->
            <div class="flex flex-col">
              <span class="text-gray-500 text-sm">Pontuação total:</span>
              <span id="totalPointsDisplay" class="font-medium">
                <%= test && test.questions ? test.questions.reduce((total, q) => total + (parseInt(q.points) || 0), 0) : '0' %> pontos
              </span>
            </div>

          </div>
        </div>

        <!-- Test content -->
        <div class="mt-8 me-8 w-7/12">
          <div class="flex justify-between items-center mb-6">
            <h2 class="text-xl font-bold text-gray-800 flex items-center">
              <i class="fas fa-clipboard-check text-secondaryGreen mr-2"></i> 
              Questões da Prova
            </h2>
            <button 
              type="button" 
              id="addQuestionBtn"
              class="px-4 py-2 bg-secondaryGreen text-white rounded-lg hover:bg-mainGreen transition-colors shadow-sm inline-flex items-center"
            >
              <i class="fas fa-plus mr-2"></i> Nova Questão
            </button>
          </div>
          
          <!-- Questions Container -->
          <div id="questionsContainer" class="space-y-8">
            <% if (test && test.questions && test.questions.length > 0) { %>
              <% test.questions.forEach((question, index) => { %>
                <div class="question-item bg-white p-6 rounded-lg shadow-md" data-id="<%= question.id %>">
                  <div class="flex items-start mb-4">
                    <span
                      class="bg-secondaryGreen text-white font-bold rounded-full w-8 h-8 flex items-center justify-center mr-3"
                      ><%= index + 1 %></span
                    >
                    <div class="flex-grow">                      <div class="flex justify-between items-start w-full">
                        <h3 class="text-xl font-bold text-gray-800 mb-1">
                          <%= question.text %>
                        </h3>
                      </div>                      <div class="flex items-center space-x-4 mt-1 mb-2">
                        <!-- Editable Points -->
                        <div class="flex items-center">
                          <label class="text-sm text-gray-500 mr-2">Pontos:</label>
                          <input 
                            type="number" 
                            class="question-points w-16 px-2 py-1 border border-gray-300 rounded text-sm" 
                            value="<%= question.points %>"
                            min="1"
                            data-id="<%= question.id %>"
                          >
                        </div>
                            <!-- Editable Question Type -->
                        <div class="flex items-center">
                          <label class="text-sm text-gray-500 mr-2">Tipo:</label>
                          <%= question.type === 'multiple-choice' ? 'Múltipla Escolha' : 'Verdadeiro/Falso' %>
                        </div>
                      </div>
                    </div>
                  </div>

                  <div class="ml-11 space-y-3 mt-3">                    <% if (question.type === 'multiple-choice' && question.options && question.options.length > 0) { %>
                      <% question.options.forEach((option, optionIndex) => { %>
                        <div class="flex items-center p-3 bg-gray-50 rounded-lg mb-2">
                          <div class="h-5 w-5 flex items-center justify-center rounded-full mr-3 bg-secondaryGreen text-white font-bold text-sm">
                            <%= String.fromCharCode(65 + optionIndex) %>
                          </div>
                          <input 
                            type="text" 
                            class="option-text-input flex-grow bg-transparent border-b border-gray-300 focus:border-secondaryGreen focus:ring-0 px-1 py-0.5" 
                            value="<%= option.text %>"
                            data-question-id="<%= question.id %>"
                            data-option-id="<%= option.id %>"
                          >
                        </div>
                      <% }); %>
                      <!-- Correct answer selector -->
                      <div class="mt-3 pt-2 border-t border-gray-200">
                        <div class="flex items-center">
                          <label class="text-sm text-gray-600 mr-2">Alternativa correta:</label>
                          <select 
                            class="correct-option-selector px-3 py-1.5 border border-gray-300 rounded focus:ring-2 focus:ring-secondaryGreen focus:border-transparent"
                            data-question-id="<%= question.id %>"
                          >
                            <% question.options.forEach((option, optionIndex) => { %>
                              <option value="<%= option.id %>" <%= option.id == question.correctAnswer ? 'selected' : '' %>>
                                <%= String.fromCharCode(65 + optionIndex) %> - <%= option.text.substring(0, 15) %><%= option.text.length > 15 ? '...' : '' %>
                              </option>
                            <% }); %>
                          </select>
                        </div>
                      </div>
                    <% } else if (question.type === 'true-false') { %>
                      <div class="flex flex-col space-y-2">
                        <div class="flex items-center p-3 bg-gray-50 rounded-lg">
                          <div class="h-5 w-5 flex items-center justify-center rounded-full mr-3 bg-blue-500 text-white font-bold">V</div>
                          <span>Verdadeiro</span>
                        </div>
                        <div class="flex items-center p-3 bg-gray-50 rounded-lg">
                          <div class="h-5 w-5 flex items-center justify-center rounded-full mr-3 bg-blue-500 text-white font-bold">F</div>
                          <span>Falso</span>
                        </div>
                        <!-- Correct answer selector -->
                        <div class="mt-3 pt-2 border-t border-gray-200">
                          <div class="flex items-center">
                            <label class="text-sm text-gray-600 mr-2">Resposta correta:</label>
                            <select 
                              class="correct-answer-selector px-3 py-1.5 border border-gray-300 rounded focus:ring-2 focus:ring-secondaryGreen focus:border-transparent"
                              data-question-id="<%= question.id %>"
                            >
                              <option value="true" <%= question.correctAnswer == true ? 'selected' : '' %>>Verdadeiro</option>
                              <option value="false" <%= question.correctAnswer == false ? 'selected' : '' %>>Falso</option>
                            </select>
                          </div>
                        </div>
                      </div>                    <% } %>
                  </div>
                  <div class="mt-3 flex justify-end">
                    <button type="button" class="delete-question-btn text-red-500 hover:text-red-700 p-2">
                        <i class="fas fa-trash-alt"></i> Excluir
                    </button>
                  </div>
                </div>
                
              <% }); %>
            <% } else { %>
              <div id="emptyState" class="bg-white p-6 rounded-lg shadow-md text-center">
                <i class="fas fa-clipboard-question text-gray-300 text-5xl mb-3"></i>
                <p class="text-xl font-medium text-gray-600">Nenhuma questão adicionada</p>
                <p class="text-gray-500 mt-2 mb-5">Clique no botão "Nova Questão" para começar a criar a prova</p>
              </div>
            <% } %>
            
          </div>
          
          <!-- Mensagem de nenhuma questão (aparece apenas quando vazio) -->
          <div id="noQuestionsMessage" class="<%= test && test.questions && test.questions.length > 0 ? 'hidden' : '' %> mt-10">
          </div>
        </div>
      </form>

      <!-- Action bar -->
      <div
        class="bg-secondaryGreen mx-auto w-full p-4 shadow-lg"
      >
        <div class="flex items-center justify-between">
          <!-- Question counter -->
          <div class="text-white font-medium">
            <span id="questionCount">
              <%= test && test.questions ? test.questions.length : 0 %>
            </span> questões •
            <span id="totalPoints">
              <%= test && test.questions ? test.questions.reduce((total, q) => total + (parseInt(q.points) || 0), 0) : '0' %>
            </span> pontos
          </div>

          <!-- Navigation buttons -->
          <div class="flex space-x-4">
            <a
              href="/contentDashboard/tests"
              class="rounded-lg bg-white/20 hover:bg-white/30 transition-colors shadow-sm text-white p-3 px-8 md:px-12 font-medium inline-flex items-center"
            >
              <i class="fas fa-times mr-2"></i>
              CANCELAR
            </a>

            <button
              type="submit"
              form="testForm"
              class="rounded-lg bg-white hover:bg-blue-200 transition-colors shadow-sm text-black p-3 px-8 md:px-12 font-medium inline-flex items-center"
            >
              <i class="fas fa-save mr-2"></i>
              <%= test && test.id ? 'ATUALIZAR PROVA' : 'CRIAR PROVA' %>
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Question Modal -->
    <div id="questionModal" class="fixed inset-0 bg-black bg-opacity-50 z-50 hidden">
      <div class="flex items-center justify-center min-h-screen p-4">
        <div class="bg-white rounded-xl shadow-xl w-full max-w-3xl">
          <div class="bg-secondaryGreen text-white py-4 px-6 rounded-t-xl flex justify-between items-center">
            <h3 id="modalTitle" class="text-xl font-bold">Nova Questão</h3>
            <button id="closeModalBtn" class="text-white hover:text-gray-200" type="button">
              <i class="fas fa-times"></i>
            </button>
          </div>
          
          <div class="p-6">
            <form id="questionForm" class="space-y-6">
              <input type="hidden" id="questionId" value="">
              
              <!-- Question Text -->
              <div>
                <label for="questionText" class="block text-gray-700 font-medium mb-1">
                  Texto da Questão*
                </label>
                <textarea 
                  id="questionText" 
                  rows="3"
                  class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-secondaryGreen focus:border-transparent"
                  placeholder="Digite o texto da questão..."
                  required
                ></textarea>
              </div>
              
              <div class="grid grid-cols-2 gap-4">
                <!-- Question Type -->
                <div>
                  <label for="questionType" class="block text-gray-700 font-medium mb-1">
                    Tipo de Questão*
                  </label>
                  <select 
                    id="questionType"
                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-secondaryGreen focus:border-transparent"
                  >
                    <option value="multiple-choice">Múltipla Escolha</option>
                    <option value="true-false">Verdadeiro ou Falso</option>
                  </select>
                </div>
                
                <!-- Points -->
                <div>
                  <label for="questionPoints" class="block text-gray-700 font-medium mb-1">
                    Pontos*
                  </label>
                  <input 
                    type="number" 
                    id="questionPoints" 
                    value="10" 
                    min="1"
                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-secondaryGreen focus:border-transparent"
                  />
                </div>
              </div>
              
              <!-- Multiple Choice Options -->
              <div id="multipleChoiceContainer" class="space-y-2">
                <div class="flex items-center justify-between">
                  <label class="block text-gray-700 font-medium">
                    Opções de Resposta*
                  </label>
                  <button 
                    type="button" 
                    id="addOptionBtn"
                    class="text-sm text-secondaryGreen hover:text-mainGreen flex items-center"
                  >
                    <i class="fas fa-plus mr-1"></i> Adicionar opção
                  </button>
                </div>
                
                <div id="optionsContainer" class="space-y-2 mt-2">
                  <!-- Options will be rendered here -->
                  <div class="option-item flex items-center">
                    <input type="radio" name="correctOption" class="mr-2" required>
                    <input 
                      type="text" 
                      class="option-text flex-grow px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-secondaryGreen focus:border-transparent"
                      placeholder="Opção 1" 
                    >
                    <button type="button" class="delete-option ml-2 text-red-500 hover:text-red-700">
                      <i class="fas fa-times"></i>
                    </button>
                  </div>
                </div>
              </div>
              
              <!-- True/False Options -->
              <div id="trueFalseContainer" class="space-y-2 hidden">
                <label class="block text-gray-700 font-medium mb-2">
                  Resposta Correta*
                </label>
                <div class="space-y-2">
                  <label class="flex items-center p-3 bg-gray-50 rounded-lg hover:bg-gray-100 cursor-pointer">
                    <input type="radio" name="trueFalseAnswer" value="true" class="mr-3">
                    <span>Verdadeiro</span>
                  </label>
                  <label class="flex items-center p-3 bg-gray-50 rounded-lg hover:bg-gray-100 cursor-pointer">
                    <input type="radio" name="trueFalseAnswer" value="false" class="mr-3">
                    <span>Falso</span>
                  </label>
                </div>
              </div>
              
              <!-- Short Answer -->
              <div id="shortAnswerContainer" class="space-y-2 hidden">
                <label for="shortAnswer" class="block text-gray-700 font-medium mb-1">
                  Resposta Correta*
                </label>
                <input 
                  type="text" 
                  id="shortAnswer" 
                  class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-secondaryGreen focus:border-transparent"
                  placeholder="Digite a resposta esperada"
                >
              </div>
              
              <!-- Code Answer -->
              <div id="codeAnswerContainer" class="space-y-2 hidden">
                <label for="codeAnswer" class="block text-gray-700 font-medium mb-1">
                  Código Correto*
                </label>
                <textarea 
                  id="codeAnswer" 
                  rows="5"
                  class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-secondaryGreen focus:border-transparent font-mono"
                  placeholder="Digite o código de referência"
                ></textarea>
              </div>
            </form>
          </div>
          
          <div class="bg-gray-50 py-4 px-6 rounded-b-xl flex justify-end space-x-3">
            <button 
              type="button" 
              id="cancelQuestionBtn"
              class="px-5 py-2 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-100 transition-colors"
            >
              Cancelar
            </button>
            <button 
              type="button" 
              id="saveQuestionBtn"
              class="px-5 py-2 bg-secondaryGreen text-white rounded-lg hover:bg-mainGreen transition-colors"
            >
              Salvar Questão
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Question Type Selection Modal -->
    <div id="questionTypeModal" class="fixed inset-0 bg-black bg-opacity-50 z-50 hidden">
      <div class="flex items-center justify-center min-h-screen p-4">
        <div class="bg-white rounded-xl shadow-xl w-full max-w-md">
          <div class="bg-secondaryGreen text-white py-4 px-6 rounded-t-xl">
            <h3 class="text-xl font-bold">Escolha o tipo de questão</h3>
          </div>
          
          <div class="p-6 space-y-4">
            <p class="text-gray-600">Selecione o tipo de questão que você deseja criar:</p>
            
            <button id="multipleChoiceBtn" class="w-full flex items-center p-4 border border-gray-200 rounded-lg hover:bg-gray-50 transition">
              <div class="h-10 w-10 rounded-full bg-blue-500 flex items-center justify-center text-white mr-3">
                <i class="fas fa-list-ul"></i>
              </div>
              <div class="text-left">
                <h4 class="font-medium text-gray-800">Múltipla Escolha</h4>
                <p class="text-sm text-gray-500">Questão com várias alternativas e uma correta</p>
              </div>
            </button>
            
            <button id="trueFalseBtn" class="w-full flex items-center p-4 border border-gray-200 rounded-lg hover:bg-gray-50 transition">
              <div class="h-10 w-10 rounded-full bg-green-500 flex items-center justify-center text-white mr-3">
                <i class="fas fa-check-circle"></i>
              </div>
              <div class="text-left">
                <h4 class="font-medium text-gray-800">Verdadeiro ou Falso</h4>
                <p class="text-sm text-gray-500">Questão com apenas duas opções: verdadeiro ou falso</p>
              </div>
            </button>
          </div>
          
          <div class="bg-gray-50 py-4 px-6 rounded-b-xl flex justify-end">
            <button id="cancelTypeSelectionBtn" class="px-5 py-2 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-100 transition-colors">
              Cancelar
            </button>
          </div>
        </div>
      </div>
    </div>    <!-- Footer -->
    <%- include('./partials/footer') %>

    <script>
      document.addEventListener('DOMContentLoaded', function() {
        // Get modal elements
        const questionTypeModal = document.getElementById('questionTypeModal');
        const addQuestionBtn = document.getElementById('addQuestionBtn');
        const multipleChoiceBtn = document.getElementById('multipleChoiceBtn');
        const trueFalseBtn = document.getElementById('trueFalseBtn');
        const cancelTypeSelectionBtn = document.getElementById('cancelTypeSelectionBtn');
        
        // Set up event listeners for the question type selection modal
        if (addQuestionBtn) {
          addQuestionBtn.addEventListener('click', function() {
            questionTypeModal.classList.remove('hidden');
          });
        }
        
        if (cancelTypeSelectionBtn) {
          cancelTypeSelectionBtn.addEventListener('click', function() {
            questionTypeModal.classList.add('hidden');
          });
        }
        
        if (multipleChoiceBtn) {
          multipleChoiceBtn.addEventListener('click', function() {
            questionTypeModal.classList.add('hidden');
            createNewQuestion('multiple-choice');
          });
        }
        
        if (trueFalseBtn) {
          trueFalseBtn.addEventListener('click', function() {
            questionTypeModal.classList.add('hidden');
            createNewQuestion('true-false');
          });
        }
          // Variables for managing questions
        let questions = [];
        let nextQuestionId = 1;
          // Load existing questions if available
        try {
          // Get questions data from the form data attribute
          const questionsJson = document.getElementById('testForm').getAttribute('data-questions');
          const questionsData = JSON.parse(questionsJson);
          questions = Array.isArray(questionsData) ? questionsData : [];
          
          // Find the highest ID to ensure new questions have unique IDs
          if (questions.length > 0) {
            // Strip the 'q' prefix if present, convert to number, and find max
            const maxId = Math.max(...questions.map(q => {
              if (typeof q.id === 'string' && q.id.startsWith('q')) {
                return parseInt(q.id.substring(1)) || 0;
              }
              return parseInt(q.id) || 0;
            }));
            nextQuestionId = maxId + 1;
          }
        } catch (e) {
          console.error('Error loading questions:', e);
          questions = [];
        }
        
        // Function to create a new question
        function createNewQuestion(type) {
          // Create a new question object
          const newQuestion = {
            id: "q" + nextQuestionId++,
            text: type === 'multiple-choice' ? 'Nova questão de múltipla escolha' : 'Nova questão de verdadeiro ou falso',
            type: type,
            points: 10
          };

          // Add type-specific properties
          if (type === 'multiple-choice') {
            newQuestion.options = [
              { id: 'a', text: 'Opção 1' },
              { id: 'b', text: 'Opção 2' },
              { id: 'c', text: 'Opção 3' },
              { id: 'd', text: 'Opção 4' },
            ];
            newQuestion.correctAnswer = 'a';
          } else if (type === 'true-false') {
            newQuestion.correctAnswer = true;
          }

          // Add the question to the list
          questions.push(newQuestion);

          // Render the updated question list
          renderQuestions();
          
          // Update question count and points
          updateStats();

          // Scroll to the new question
          setTimeout(() => {
            const newQuestionElement = document.querySelector(`.question-item[data-id="${newQuestion.id}"]`);
            if (newQuestionElement) {
              newQuestionElement.scrollIntoView({ behavior: 'smooth' });
            }
          }, 100);
        }
        
        // Function to delete a question
        function deleteQuestion(questionId) {
          if (confirm('Tem certeza que deseja excluir esta questão?')) {
            // Find the question index
            const index = questions.findIndex(q => q.id == questionId);
            if (index !== -1) {
              // Remove the question
              questions.splice(index, 1);
              
              // Update the UI
              renderQuestions();
              updateStats();
              
              // Update the hidden input
              document.getElementById('questionsData').value = JSON.stringify(questions);
            }
          }
        }
        
        // Function to render all questions
        function renderQuestions() {
          const questionsContainer = document.getElementById('questionsContainer');
          
          // Show empty state if no questions
          if (questions.length === 0) {
            questionsContainer.innerHTML = `
              <div id="emptyState" class="bg-white p-6 rounded-lg shadow-md text-center">
                <i class="fas fa-clipboard-question text-gray-300 text-5xl mb-3"></i>
                <p class="text-xl font-medium text-gray-600">Nenhuma questão adicionada</p>
                <p class="text-gray-500 mt-2 mb-5">Clique no botão "Nova Questão" para começar a criar a prova</p>
              </div>
            `;
            return;
          }
          
          // Render each question
          questionsContainer.innerHTML = '';
          questions.forEach((question, index) => {
            const questionEl = document.createElement('div');
            questionEl.className = 'question-item bg-white p-6 rounded-lg shadow-md';
            questionEl.dataset.id = question.id;
            
            let optionsHTML = '';
            if (question.type === 'multiple-choice' && question.options && question.options.length > 0) {
              // Generate options HTML
              let alternativesHTML = '';
              question.options.forEach((option, optionIndex) => {
                alternativesHTML += `
                  <div class="flex items-center p-3 bg-gray-50 rounded-lg mb-2">
                    <div class="h-5 w-5 flex items-center justify-center rounded-full mr-3 bg-secondaryGreen text-white font-bold text-sm">
                      ${String.fromCharCode(65 + optionIndex)}
                    </div>
                    <input 
                      type="text" 
                      class="option-text-input flex-grow bg-transparent border-b border-gray-300 focus:border-secondaryGreen focus:ring-0 px-1 py-0.5" 
                      value="${option.text}"
                      data-question-id="${question.id}"
                      data-option-id="${option.id}"
                    >
                  </div>
                `;
              });
              
              // Generate selector for correct option
              let selectorHTML = `
                <div class="mt-3 pt-2 border-t border-gray-200">
                  <div class="flex items-center justify-between">
                    <div class="flex items-center">
                      <label class="text-sm text-gray-600 mr-2">Alternativa correta:</label>
                      <select 
                        class="correct-option-selector px-3 py-1.5 border border-gray-300 rounded focus:ring-2 focus:ring-secondaryGreen focus:border-transparent"
                        data-question-id="${question.id}"
                      >
              `;
              
              question.options.forEach((option, optionIndex) => {
                selectorHTML += `
                  <option value="${option.id}" ${option.id == question.correctAnswer ? 'selected' : ''}>
                    ${String.fromCharCode(65 + optionIndex)} - ${option.text.substring(0, 15)}${option.text.length > 15 ? '...' : ''}
                  </option>
                `;
              });
              
              selectorHTML += `
                      </select>
                    </div>
                    <button type="button" class="delete-question-btn text-red-500 hover:text-red-700 p-2">
                      <i class="fas fa-trash-alt"></i> Excluir
                    </button>
                  </div>
                </div>
              `;
              
              optionsHTML = alternativesHTML + selectorHTML;
            } else if (question.type === 'true-false') {
              optionsHTML = `
                <div class="flex flex-col space-y-2">
                  <div class="flex items-center p-3 bg-gray-50 rounded-lg">
                    <div class="h-5 w-5 flex items-center justify-center rounded-full mr-3 bg-blue-500 text-white font-bold">V</div>
                    <span>Verdadeiro</span>
                  </div>
                  <div class="flex items-center p-3 bg-gray-50 rounded-lg">
                    <div class="h-5 w-5 flex items-center justify-center rounded-full mr-3 bg-blue-500 text-white font-bold">F</div>
                    <span>Falso</span>
                  </div>
                  <!-- Correct answer selector -->
                  <div class="mt-3 pt-2 border-t border-gray-200">
                    <div class="flex items-center justify-between">
                      <div class="flex items-center">
                        <label class="text-sm text-gray-600 mr-2">Resposta correta:</label>
                        <select 
                          class="correct-answer-selector px-3 py-1.5 border border-gray-300 rounded focus:ring-2 focus:ring-secondaryGreen focus:border-transparent"
                          data-question-id="${question.id}"
                        >
                          <option value="true" ${question.correctAnswer === true ? 'selected' : ''}>Verdadeiro</option>
                          <option value="false" ${question.correctAnswer === false ? 'selected' : ''}>Falso</option>
                        </select>
                      </div>
                      <button type="button" class="delete-question-btn text-red-500 hover:text-red-700 p-2">
                        <i class="fas fa-trash-alt"></i> Excluir
                      </button>
                    </div>
                  </div>
                </div>
              `;
            } 
            
            questionEl.innerHTML = `
              <div class="flex items-start mb-4">
                <span
                  class="bg-secondaryGreen text-white font-bold rounded-full w-8 h-8 flex items-center justify-center mr-3"
                  >${index + 1}</span
                >
                <div class="flex-grow">              <div class="flex justify-between items-start w-full">
                    <h3 class="text-xl font-bold text-gray-800 mb-1 editable-text" contenteditable="true" data-id="${question.id}">
                      ${question.text}
                    </h3>
                  </div>
                  <div class="flex items-center space-x-4 mt-1 mb-2">
                    <!-- Editable Points -->
                    <div class="flex items-center">
                      <label class="text-sm text-gray-500 mr-2">Pontos:</label>
                      <input 
                        type="number" 
                        class="question-points w-16 px-2 py-1 border border-gray-300 rounded text-sm" 
                        value="${question.points}"
                        min="1"
                        data-id="${question.id}"
                      >
                    </div>
                    
                    <!-- Question Type -->
                    <div class="flex items-center">
                      <label class="text-sm text-gray-500 mr-2">Tipo:</label>
                      ${question.type === 'multiple-choice' ? 'Múltipla Escolha' : 'Verdadeiro/Falso'}
                    </div>
                  </div>
                </div>
              </div>

              <div class="ml-11 space-y-3 mt-3">
                ${optionsHTML}
              </div>
            `;
            
            questionsContainer.appendChild(questionEl);
          });
              // Update hidden input with questions data
          document.getElementById('questionsData').value = JSON.stringify(questions);
          
          // Attach event listeners to newly created elements
          attachEventListeners();
        }
        
        // Attach event listeners to dynamic elements
        function attachEventListeners() {
          // Delete question buttons
          document.querySelectorAll('.delete-question-btn').forEach(btn => {
            btn.addEventListener('click', function() {
              const questionItem = this.closest('.question-item');
              const questionId = questionItem.dataset.id;
              deleteQuestion(questionId);
            });
          });
          
          // Points inputs
          document.querySelectorAll('.question-points').forEach(input => {
            input.addEventListener('change', function() {
              const questionId = this.getAttribute('data-id');
              const newPoints = parseInt(this.value) || 0;
              
              if (newPoints < 1) {
                alert('A pontuação deve ser um número positivo');
                this.value = 1;
                return;
              }
              
              // Update points
              const question = questions.find(q => q.id == questionId);
              if (question) {
                question.points = newPoints;
                updateStats();
                document.getElementById('questionsData').value = JSON.stringify(questions);
              }
            });
          });
          
          // Option text inputs
          document.querySelectorAll('.option-text-input').forEach(input => {
            input.addEventListener('change', function() {
              const questionId = this.getAttribute('data-question-id');
              const optionId = this.getAttribute('data-option-id');
              const newText = this.value.trim();
              
              // Update option text
              const question = questions.find(q => q.id == questionId);
              if (question && question.options) {
                const option = question.options.find(o => o.id == optionId);
                if (option) {
                  option.text = newText;
                  
                  // Update selector text
                  const selector = document.querySelector(`.correct-option-selector[data-question-id="${questionId}"]`);
                  if (selector) {
                    const optionIndex = question.options.findIndex(o => o.id == optionId);
                    if (optionIndex !== -1) {
                      const optionElement = selector.querySelector(`option[value="${optionId}"]`);
                      if (optionElement) {
                        const letterPrefix = String.fromCharCode(65 + optionIndex);
                        optionElement.textContent = `${letterPrefix} - ${newText.substring(0, 15)}${newText.length > 15 ? '...' : ''}`;
                      }
                    }
                  }
                  
                  document.getElementById('questionsData').value = JSON.stringify(questions);
                }
              }
            });
          });
          
          // Correct answer selectors for multiple choice
          document.querySelectorAll('.correct-option-selector').forEach(select => {
            select.addEventListener('change', function() {
              const questionId = this.getAttribute('data-question-id');
              const newCorrectOptionId = this.value;
              
              // Update correct answer
              const question = questions.find(q => q.id == questionId);
              if (question) {
                question.correctAnswer = newCorrectOptionId;
                document.getElementById('questionsData').value = JSON.stringify(questions);
              }
            });
          });
          
          // Correct answer selectors for true/false
          document.querySelectorAll('.correct-answer-selector').forEach(select => {
            select.addEventListener('change', function() {
              const questionId = this.getAttribute('data-question-id');
              const newCorrectAnswer = this.value === 'true';
              
              // Update correct answer
              const question = questions.find(q => q.id == questionId);
              if (question) {
                question.correctAnswer = newCorrectAnswer;
                document.getElementById('questionsData').value = JSON.stringify(questions);
              }
            });
          });
          
          // Editable question text
          document.querySelectorAll('.editable-text').forEach(element => {
            element.addEventListener('blur', function() {
              const questionId = this.getAttribute('data-id');
              const newText = this.innerText.trim();
              
              // Update question text
              const question = questions.find(q => q.id == questionId);
              if (question) {
                question.text = newText;
                document.getElementById('questionsData').value = JSON.stringify(questions);
              }
            });
            
            element.addEventListener('keydown', function(e) {
              // Save on Enter key (but allow shift+enter for new lines)
              if (e.key === 'Enter' && !e.shiftKey) {
                e.preventDefault();
                this.blur();
              }
            });
          });
        }
        
        // Update stats (question count and total points)
        function updateStats() {
          const totalPoints = questions.reduce((sum, q) => sum + (parseInt(q.points) || 0), 0);
          
          document.getElementById('questionCount').textContent = questions.length;
          document.getElementById('totalPoints').textContent = totalPoints;
          document.getElementById('totalPointsDisplay').textContent = `${totalPoints} pontos`;
        }
        
        // Initialize
        renderQuestions();
        updateStats();
      });
    </script>
  </body>
</html>
