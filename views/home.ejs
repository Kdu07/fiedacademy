<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Home | FieldAcademy</title>
    <link rel="stylesheet" href="/css/style.css" />
    <link rel="stylesheet" href="/css/main-layout.css" />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    />
  </head>
  <body class="bg-gray-50 text-gray-800">
    <%- include('./partials/header') %>

    <div class="content-wrapper">
      <!-- Hero Section -->
      <section class="relative">
        <div class="w-full h-[300px] md:h-[350px] overflow-hidden">
          <img
            src="/assets/bg-final-home.jpg"
            alt="Campo"
            class="w-full h-full object-cover brightness-75"
          />
          <div class="absolute inset-0 bg-secondaryGreen bg-opacity-60"></div>
          <div
            class="absolute inset-0 flex flex-col justify-center items-center text-white px-4 md:px-0"
          >
            <h1 class="text-3xl md:text-4xl font-bold text-center mb-4">
              Bem-vindo(a), <%= user.name %>!
            </h1>
            <p class="text-lg md:text-xl text-center max-w-2xl mb-6">
              Continue seu aprendizado e acompanhe seu progresso aqui.
            </p>
            <a
              href="/help"
              class="bg-white hover:bg-gray-100 text-secondaryGreen py-3 px-8 rounded-lg font-bold text-lg transition-all flex items-center"
            >
              <i class="fas fa-question-circle mr-2"></i>
              Precisa de Ajuda?
            </a>
          </div>
        </div>
      </section>

      <div class="max-w-7xl mx-auto px-4 py-8">
        <!-- Main Sections Grid - Reorganized with improved sizing -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 mb-10">
          <!-- Trilhas Section - Resized to be more proportional -->
          <div class="lg:col-span-7 bg-white p-6 rounded-lg shadow-md">
            <div class="flex items-center mb-6 pb-2 border-b border-gray-100">
              <div
                class="w-10 h-10 bg-secondaryGreen/10 rounded-full flex items-center justify-center mr-3"
              >
                <i class="fas fa-route text-secondaryGreen"></i>
              </div>
              <h2 class="text-2xl font-bold">Trilhas de Aprendizado</h2>
            </div>

            <% if (paths && paths.length) { %>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <% paths.forEach(t => { %>
              <a
                href="/paths/<%= t.id %>"
                class="bg-gray-50 rounded-lg p-3 hover:bg-gray-100 transition-colors border border-gray-100 flex items-center"
              >
                <div
                  class="w-8 h-8 bg-secondaryGreen/10 rounded-full flex items-center justify-center mr-2"
                >
                  <i class="fas fa-book-open text-secondaryGreen text-sm"></i>
                </div>
                <div class="flex-grow">
                  <h3 class="font-medium text-sm md:text-base">
                    <%= t.title %>
                  </h3>
                  <p class="text-xs text-gray-500">Clique para acessar</p>
                </div>
                <i class="fas fa-chevron-right text-gray-400 text-sm"></i>
              </a>
              <% }) %>
            </div>
            <% } else { %>
            <div
              class="flex flex-col items-center justify-center py-10 bg-gray-50 rounded-lg"
            >
              <i class="fas fa-map-signs text-4xl text-gray-400 mb-3"></i>
              <p class="text-center text-gray-500">
                Nenhuma trilha encontrada.
              </p>
            </div>
            <% } %>
          </div>

          <!-- Ranking Section - Resized to be more proportional -->
          <div class="lg:col-span-5 bg-white p-6 rounded-lg shadow-md">
            <div class="flex items-center mb-6 pb-2 border-b border-gray-100">
              <div
                class="w-10 h-10 bg-secondaryGreen/10 rounded-full flex items-center justify-center mr-3"
              >
                <i class="fas fa-trophy text-secondaryGreen"></i>
              </div>
              <h2 class="text-2xl font-bold">Top 10 Ranking</h2>
            </div>

            <% if (ranking && ranking.length) { %>
            <div class="space-y-2 max-h-[400px] overflow-y-auto pr-1">
              <% ranking.slice(0, 10).forEach((rankUser, index) => { const
              isCurrentUser = rankUser.id === user.id; %>
              <div
                class="flex items-center p-2 <%= isCurrentUser ? 'bg-green-50 border border-secondaryGreen' : (index < 3 ? 'bg-yellow-50' : 'bg-gray-50') %> rounded-lg"
              >
                <div
                  class="w-7 h-7 <%= index < 3 ? 'bg-yellow-400' : 'bg-gray-200' %> rounded-full flex items-center justify-center mr-3"
                >
                  <span
                    class="<%= index < 3 ? 'text-yellow-800' : 'text-gray-700' %> font-bold text-sm"
                    ><%= rankUser.rank %></span
                  >
                </div>
                <div class="flex-grow">
                  <a
                    href="/profile/<%= rankUser.id %>"
                    class="<%= isCurrentUser ? 'font-bold' : 'font-medium' %> text-sm md:text-base hover:text-secondaryGreen transition-colors <%= isCurrentUser ? 'text-secondaryGreen' : '' %>"
                  >
                    <%= rankUser.name %> <% if (isCurrentUser) { %>
                    <span
                      class="ml-1 text-xs bg-secondaryGreen text-white px-2 py-0.5 rounded-full"
                      >Você</span
                    >
                    <% } %>
                  </a>
                </div>
                <div class="flex items-center">
                  <i class="fas fa-star text-yellow-500 mr-1 text-sm"></i>
                  <span class="font-bold text-sm"><%= rankUser.score %></span>
                </div>
              </div>
              <% }) %> <% // Check if current user is not in top 10 const
              userInTop10 = ranking.slice(0, 10).some(r => r.id === user.id);
              const userRank = ranking.find(r => r.id === user.id); if
              (!userInTop10 && userRank) { %>
              <div class="mt-4 pt-4 border-t border-dashed border-gray-300">
                <div
                  class="flex items-center p-2 bg-green-50 border border-secondaryGreen rounded-lg"
                >
                  <div
                    class="w-7 h-7 bg-secondaryGreen rounded-full flex items-center justify-center mr-3"
                  >
                    <span class="text-white font-bold text-sm"
                      ><%= userRank.rank %></span
                    >
                  </div>
                  <div class="flex-grow">
                    <span
                      class="font-bold text-sm md:text-base text-secondaryGreen"
                    >
                      <%= user.name %>
                      <span
                        class="ml-1 text-xs bg-secondaryGreen text-white px-2 py-0.5 rounded-full"
                        >Você</span
                      >
                    </span>
                  </div>
                  <div class="flex items-center">
                    <i class="fas fa-star text-yellow-500 mr-1 text-sm"></i>
                    <span class="font-bold text-sm"><%= userRank.score %></span>
                  </div>
                </div>
                <p class="text-center text-sm text-gray-500 mt-2">
                  Continue ganhando pontos para subir no ranking!
                </p>
              </div>
              <% } %>
            </div>
            <% } else { %>
            <div
              class="flex flex-col items-center justify-center py-10 bg-gray-50 rounded-lg"
            >
              <i class="fas fa-trophy text-4xl text-gray-400 mb-3"></i>
              <p class="text-center text-gray-500">
                Nenhum usuário no ranking.
              </p>
            </div>
            <% } %>
          </div>
        </div>

        <!-- Favoritos Section -->
        <div class="bg-white p-6 rounded-lg shadow-md mb-10">
          <div class="flex items-center mb-6 pb-2 border-b border-gray-100">
            <div
              class="w-10 h-10 bg-secondaryGreen/10 rounded-full flex items-center justify-center mr-3"
            >
              <i class="fas fa-bookmark text-secondaryGreen"></i>
            </div>
            <h2 class="text-2xl font-bold">Conteúdos Favoritos</h2>
          </div>

          <% if (bookmarks && bookmarks.length) { %>
          <div class="overflow-x-auto">
            <table class="min-w-full">
              <thead>
                <tr class="bg-gray-50 text-left">
                  <th class="py-3 px-4 font-semibold text-gray-600 border-b">
                    Conteúdo
                  </th>
                  <th class="py-3 px-4 font-semibold text-gray-600 border-b">
                    Trilha
                  </th>
                  <th
                    class="py-3 px-4 font-semibold text-gray-600 border-b text-center"
                  >
                    Ações
                  </th>
                </tr>
              </thead>
              <tbody>
                <% bookmarks.forEach(b => { %>
                <tr class="hover:bg-gray-50 transition-colors">
                  <td class="py-3 px-4 border-b">
                    <a
                      href="<%= b.url %>"
                      class="text-secondaryGreen hover:underline flex items-center"
                    >
                      <i class="fas fa-file-alt mr-2"></i>
                      <%= b.contents_title %>
                    </a>
                  </td>
                  <td class="py-3 px-4 border-b">
                    <span
                      class="bg-green-100 text-green-800 text-xs font-medium py-1 px-2 rounded-full"
                    >
                      <%= b.path_title %>
                    </span>
                  </td>
                  <td class="py-3 px-4 border-b text-center">
                    <form
                      action="/bookmarks/delete/<%= b.id %>"
                      method="POST"
                      onsubmit="return confirm('Deseja remover este favorito?');"
                    >
                      <button
                        type="submit"
                        class="text-red-500 hover:text-red-700 transition-colors"
                      >
                        <i class="fas fa-trash-alt"></i>
                      </button>
                    </form>
                  </td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
          <% } else { %>
          <div
            class="flex flex-col items-center justify-center py-10 bg-gray-50 rounded-lg"
          >
            <i class="fas fa-bookmark text-4xl text-gray-400 mb-3"></i>
            <p class="text-center text-gray-500">
              Você ainda não adicionou nenhum favorito.
            </p>
          </div>
          <% } %>
        </div>

        <!-- Quick Stats Section - Updated with only one card -->
        <div class="grid grid-cols-1 gap-6 mb-10">
          <!-- Your Position Summary -->
          <div
            class="bg-white p-6 rounded-lg shadow-md border-t-4 border-secondaryGreen"
          >
            <div class="flex items-center mb-6 pb-2 border-b border-gray-100">
              <div
                class="w-10 h-10 bg-secondaryGreen/10 rounded-full flex items-center justify-center mr-3"
              >
                <i class="fas fa-chart-line text-secondaryGreen"></i>
              </div>
              <h2 class="text-2xl font-bold">Seu Progresso</h2>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
              <!-- Pontuação Total Card -->
              <div
                class="bg-gradient-to-br from-green-50 to-emerald-100 p-5 rounded-lg border border-green-200 shadow-sm"
              >
                <div class="flex items-center justify-between mb-3">
                  <span class="font-semibold text-gray-700"
                    >Pontuação Total</span
                  >
                  <div
                    class="w-8 h-8 bg-green-500 bg-opacity-20 rounded-full flex items-center justify-center"
                  >
                    <i class="fas fa-star text-green-600"></i>
                  </div>
                </div>
                <div class="flex items-baseline">
                  <% const userScore = ranking && ranking.find(r => r.id ===
                  user.id)?.score; %>
                  <p class="text-3xl font-bold text-green-700">
                    <%= userScore || '0' %>
                  </p>
                  <span class="ml-1 text-sm text-gray-600">pontos</span>
                </div>
                <p class="text-xs text-gray-500 mt-4">Seu total de pontos!</p>
              </div>

              <!-- Classificação Card -->
              <div
                class="bg-gradient-to-br from-blue-50 to-indigo-100 p-5 rounded-lg border border-blue-200 shadow-sm"
              >
                <div class="flex items-center justify-between mb-3">
                  <span class="font-semibold text-gray-700"
                    >Sua Classificação</span
                  >
                  <div
                    class="w-8 h-8 bg-blue-500 bg-opacity-20 rounded-full flex items-center justify-center"
                  >
                    <i class="fas fa-medal text-blue-600"></i>
                  </div>
                </div>
                <div class="flex items-baseline">
                  <% const userRank = ranking && ranking.find(r => r.id ===
                  user.id)?.rank; %>
                  <p class="text-3xl font-bold text-blue-700">
                    <%= userRank || 'N/A' %>
                  </p>
                  <span class="ml-1 text-sm text-gray-600">no ranking</span>
                </div>
                <div class="mt-3">
                  <% if (userRank) { %> <% if (userRank <= 3) { %>
                  <span
                    class="bg-yellow-400 text-yellow-800 text-xs font-medium py-1 px-2 rounded-full"
                    >Top 3!</span
                  >
                  <% } else if (userRank <= 10) { %>
                  <span
                    class="bg-blue-400 text-blue-800 text-xs font-medium py-1 px-2 rounded-full"
                    >Top 10!</span
                  >
                  <% } else { %>
                  <p class="text-xs text-gray-500 mt-4">Continue assim!</p>
                  <% }} else { %>
                  <p class="text-xs text-gray-500">
                    Complete atividades para entrar no ranking
                  </p>
                  <% } %>
                </div>
              </div>

              <!-- Conteúdos Card -->
              <div
                class="bg-gradient-to-br from-purple-50 to-violet-100 p-5 rounded-lg border border-purple-200 shadow-sm"
              >
                <div class="flex items-center justify-between mb-3">
                  <span class="font-semibold text-gray-700"
                    >Conteúdos Salvos</span
                  >
                  <div
                    class="w-8 h-8 bg-purple-500 bg-opacity-20 rounded-full flex items-center justify-center"
                  >
                    <i class="fas fa-bookmark text-purple-600"></i>
                  </div>
                </div>
                <div class="flex items-baseline">
                  <p class="text-3xl font-bold text-purple-700">
                    <%= bookmarks ? bookmarks.length : '0' %>
                  </p>
                  <span class="ml-1 text-sm text-gray-600">favoritos</span>
                </div>
                <div class="mt-3 flex">
                  <p class="text-xs text-gray-500 mt-2">
                    Seus conteúdos favoritos
                  </p>
                </div>
              </div>
            </div>

            <div class="mt-6 bg-gray-50 p-4 rounded-lg border border-gray-200">
              <div class="flex items-center">
                <i class="fas fa-lightbulb text-yellow-500 mr-2"></i>
                <p class="text-sm text-gray-600">
                  <span class="font-medium">Dica:</span> Complete as trilhas e
                  faça os quizzes para ganhar mais pontos e subir no ranking!
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <%- include('./partials/footer') %>
  </body>
</html>
