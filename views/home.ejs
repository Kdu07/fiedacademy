<!DOCTYPE html>
<html lang="pt-br">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>FieldAcademy</title>
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body class="bg-white text-green-900">
    <%- include('./partials/header') %>

    <!-- Banner -->
    <section class="relative">
      <img
        src="/assets/bg_home.png"
        alt="campo"
        class="w-full h-48 object-cover"
      />
      <h1
        class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 text-4xl font-bold text-green-900"
      >
        FieldAcademy
      </h1>
    </section>

    <!-- Barra de ajuda -->
    <div class="flex justify-center mt-4">
      <input
        type="text"
        placeholder="Help"
        class="border border-gray-300 rounded-md px-4 py-2 w-1/2"
      />
    </div>

    <!-- Trilhas -->
    <section class="max-w-md mx-auto mt-8 border rounded-lg p-6 shadow-sm">
      <h2 class="text-center text-2xl font-semibold mb-6">TRILHAS</h2>
      <% if (paths && paths.length) { %> <% paths.forEach(t => { const slug =
      t.title.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,
      "").replace(/\s+/g, '-'); %>
      <div class="flex items-center justify-between mb-4">
        <p class="text-lg font-medium"><%= t.title %></p>
        <a
          href="/paths"
          class="bg-green-200 text-green-900 font-semibold px-4 py-1 rounded-full hover:bg-green-300"
        >
          Continuar
        </a>
      </div>
      <% }) %> <% } else { %>
      <p class="text-center text-gray-500">Nenhuma trilha encontrada.</p>
      <% } %>
    </section>

    <!-- Tabela de conteúdos fixados -->
    <section class="max-w-4xl mx-auto mt-10">
      <h2 class="text-2xl font-semibold mb-4">Favoritos</h2>
      <table
        class="min-w-full bg-white border border-gray-300 rounded-lg shadow-sm"
      >
        <thead>
          <tr class="bg-green-100 text-left">
            <th class="py-2 px-4 border-b">Conteúdo</th>
            <th class="py-2 px-4 border-b">Trilha</th>
            <th class="py-2 px-4 border-b">Status</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td class="py-2 px-4 border-b">Introdução ao Sistema</td>
            <td class="py-2 px-4 border-b">Onboarding</td>
            <td class="py-2 px-4 border-b text-green-600 font-medium">
              Concluído
            </td>
          </tr>
          <tr>
            <td class="py-2 px-4 border-b">Primeiros passos</td>
            <td class="py-2 px-4 border-b">Básico</td>
            <td class="py-2 px-4 border-b text-yellow-600 font-medium">
              Em andamento
            </td>
          </tr>
        </tbody>
      </table>
    </section>

    <%- include('./partials/footer') %>
  </body>
</html>
