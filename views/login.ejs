<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Login | FieldAcademy</title>
    <link rel="stylesheet" href="/css/style.css" />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    />
    <link rel="icon" type="image/x-icon" href="/images/favicon.ico" />
  </head>

  <body class="h-screen">
    <div class="bg-login-bg h-full w-full fixed bg-cover bg-center ">
       <div class="absolute inset-0 backdrop-blur-sm z-0"></div>
  
      <!-- Content container -->
      <div class="flex h-full w-full items-center justify-center px-4 relative z-10">
        <div
          class="flex w-full max-w-4xl overflow-hidden rounded-xl shadow-2xl"
        >
          <!-- Left column - Brand imagery -->
          <div
            class="hidden md:block md:w-1/2 bg-gradient-to-br from-mainGreen to-secondaryGreen p-8"
          >
            <div class="flex h-full flex-col items-center justify-between">
              <!-- Logo at top -->
              <div class="w-full flex justify-center">
                <img
                  src="/images/logo.png"
                  alt="FieldAcademy Logo"
                  class="h-16 w-auto"
                />
              </div>

              <!-- Brand imagery middle -->
              <div class="text-center my-8">
                <h2 class="text-3xl font-bold text-white mb-4">
                  Bem-vindo à FieldAcademy
                </h2>
                <p class="text-white/90 mb-6">
                  Sua plataforma completa de conhecimento agrícola
                </p>
                <div
                  class="p-4 bg-white/10 rounded-lg backdrop-blur-sm border border-white/20"
                >
                  <i class="fas fa-seedling text-4xl text-white mb-3"></i>
                  <p class="text-white text-sm">
                    Aprenda, cresça e colha os frutos do conhecimento
                  </p>
                </div>
              </div>

              <!-- Footer with copyright -->
              <div class="w-full text-center">
                <p class="text-sm text-white/70">
                  © <%= new Date().getFullYear() %> FieldAcademy. Todos os
                  direitos reservados.
                </p>
              </div>
            </div>
          </div>

          <!-- Right column - Login form -->
          <div class="w-full md:w-1/2 bg-white p-8">
            <div class="flex flex-col h-full">
              <!-- Mobile logo -->
              <div class="md:hidden w-full flex justify-center mb-8">
                <img
                  src="/images/logo.png"
                  alt="FieldAcademy Logo"
                  class="h-12 w-auto"
                />
              </div>

              <!-- Login content -->
              <div class="flex-grow">
                <div class="text-center mb-8">
                  <h1 class="text-3xl font-bold text-gray-800">
                    Acesse sua conta
                  </h1>
                  <p class="text-gray-500 mt-2">
                    Entre para continuar sua jornada de aprendizado
                  </p>
                </div>

                <form action="/api/login-user" class="space-y-5" method="POST">
                  <div>
                    <label
                      for="email"
                      class="block text-sm font-medium text-gray-700 mb-1"
                      >Email</label
                    >
                    <div class="relative">
                      <div
                        class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none"
                      >
                        <i class="fas fa-envelope text-gray-400"></i>
                      </div>
                      <input
                        type="email"
                        name="email"
                        id="email"
                        class="pl-10 w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-secondaryGreen focus:border-transparent transition-colors"
                        placeholder="Digite seu email"
                        required
                      />
                    </div>
                  </div>

                  <div>
                    <div class="flex items-center justify-between mb-1">
                      <label
                        for="password"
                        class="block text-sm font-medium text-gray-700"
                        >Senha</label
                      >
                    </div>
                    <div class="relative">
                      <div
                        class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none"
                      >
                        <i class="fas fa-lock text-gray-400"></i>
                      </div>
                      <input
                        type="password"
                        name="password"
                        id="password"
                        class="pl-10 w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-secondaryGreen focus:border-transparent transition-colors"
                        placeholder="Digite sua senha"
                        required
                      />
                      <div
                        class="absolute inset-y-0 right-0 pr-3 flex items-center"
                      >
                        <i
                          id="password-toggle"
                          class="fas fa-eye text-gray-400 cursor-pointer hover:text-gray-600"
                        ></i>
                      </div>
                    </div>
                  </div>

                  <% if(error) { %>
                  <div class="bg-red-50 border-l-4 border-red-500 p-3 rounded">
                    <div class="flex items-center">
                      <i
                        class="fas fa-exclamation-circle text-red-500 mr-2"
                      ></i>
                      <p class="text-red-700 text-sm" id="errorMessage">
                        <%= error %>
                      </p>
                    </div>
                  </div>
                  <% } %>

                  <button
                    type="submit"
                    class="w-full py-3 px-4 bg-gradient-to-r from-mainGreen to-secondaryGreen hover:from-mainGreen/90 hover:to-secondaryGreen/90 text-white font-medium rounded-lg shadow-lg hover:shadow-xl transition-all duration-200 flex items-center justify-center"
                  >
                    <i class="fas fa-sign-in-alt mr-2"></i>
                    <span>Entrar</span>
                  </button>
                </form>
              </div>

              <!-- Mobile copyright footer -->
              <div class="mt-8 md:hidden">
                <p class="text-xs text-center text-gray-400">
                  © <%= new Date().getFullYear() %> FieldAcademy. Todos os
                  direitos reservados.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <script>
      // Toggle password visibility
      document
        .getElementById("password-toggle")
        .addEventListener("click", function () {
          const passwordInput = document.getElementById("password");
          const passwordIcon = document.getElementById("password-toggle");

          if (passwordInput.type === "password") {
            passwordInput.type = "text";
            passwordIcon.classList.remove("fa-eye");
            passwordIcon.classList.add("fa-eye-slash");
          } else {
            passwordInput.type = "password";
            passwordIcon.classList.remove("fa-eye-slash");
            passwordIcon.classList.add("fa-eye");
          }
        });
    </script>
  </body>
</html>
