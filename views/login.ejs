<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Login - Plataforma Bayer Agro</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gradient-to-br from-[#0057A6] to-[#78BE20] min-h-screen flex items-center justify-center">

  <div class="bg-white rounded-2xl shadow-xl p-10 w-full max-w-md">
    <div class="flex flex-col items-center mb-8">
      <img src="https://www.bayer.com/sites/default/files/styles/16_9_1280x720/public/2021-01/bayer-logo.png" alt="Bayer Logo" class="h-16 mb-2">
      <h1 class="text-2xl font-bold text-[#0057A6]">Bem-vindo</h1>
      <p class="text-gray-500 text-center">Acesse a plataforma de treinamentos Bayer Agro</p>
    </div>
    <form>
      <div class="mb-4">
        <label class="block text-gray-700 font-medium mb-1" for="email">E-mail</label>
        <input id="email" type="email" class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-[#78BE20]" placeholder="seu.email@bayer.com" required>
      </div>
      <div class="mb-6">
        <label class="block text-gray-700 font-medium mb-1" for="password">Senha</label>
        <input id="password" type="password" class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-[#78BE20]" placeholder="Digite sua senha" required>
      </div>
      <button type="submit" class="w-full bg-[#0057A6] text-white font-semibold py-2 rounded-lg hover:bg-[#78BE20] transition">Entrar</button>
    </form>
    <div class="mt-6 text-center">
      <a href="#" class="text-[#0057A6] hover:text-[#78BE20] text-sm">Esqueceu a senha?</a>
    </div>
  </div>

</body>
</html>