<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Importa o arquivo de estilos CSS -->
    <link href="/css/style.css" rel="stylesheet" />
    <!-- Título da página exibida na aba do navegador -->
    <title>Grupo 05</title>
  </head>
  <body class="bg-gray-50">
    <!-- Cabeçalho  -->
    <%- include('./partials/header') %>

    <div class="mt-16">
      <div
        class="bg-mainGreen h-20 rounded-e-xl w-2/6 flex items-center mb-8 shadow-md"
      >
        <h1 class="text-white ms-8 text-3xl font-bold"><%= module.title %></h1>
      </div>

      <div class="flex flex-row justify-between mb-16">
        <!-- Botões para avançar lição - Improved version -->
        <div
          class="bg-white mt-8 ms-8 w-3/12 rounded-xl flex flex-col p-6 shadow-md border border-gray-100"
        >
          <h2
            class="text-mainGreen font-bold text-xl mb-4 text-center border-b border-gray-100 pb-2"
          >
            Lições
          </h2>
          <div class="w-full grid gap-3">
            <% modulePages.forEach(page => { const isCurrentPage =
            page.content_order === moduleContent.content_order; %>
            <a
              href="/path/<%= pathId %>/module/1/page/<%= page.content_order %>"
              class="block w-full"
            >
              <div
                class="rounded-lg <%= isCurrentPage ? 'bg-mainGreen' : 'bg-mainGreen/80 hover:bg-mainGreen' %> transition-all duration-200 shadow-sm <%= isCurrentPage ? 'ring-2 ring-offset-2 ring-mainGreen' : '' %>"
              >
                <div class="px-4 py-3 flex items-center">
                  <div
                    class="flex-shrink-0 <%= isCurrentPage ? 'bg-white text-mainGreen' : 'bg-white/30 text-white' %> w-8 h-8 rounded-full flex items-center justify-center font-bold mr-3"
                  >
                    <%= page.content_order %>
                  </div>
                  <p class="text-white font-medium">
                    Lição <%= page.content_order %> <% if (isCurrentPage) { %>
                    <% } %>
                  </p>
                </div>
              </div>
            </a>
            <% }) %>
          </div>
        </div>
        <!-- Conteúdo da lição -->
        <div
          class="mt-8 me-8 w-7/12 rounded-lg flex flex-col items-start h-1/2"
        >
          <div class="w-full bg-white p-6 rounded-lg shadow-md">
            <div
              class="flex justify-between items-center mb-4 pb-2 border-b border-gray-100"
            >
              <h1 class="text-2xl font-bold text-gray-800">
                <%= moduleContent.title %>
              </h1>
              <!-- Bookmark button moved here -->
              <form action="/bookmarks/toggle" method="POST">
                <input
                  type="hidden"
                  name="contentId"
                  value="<%= moduleContent.id %>"
                />
                <% if(moduleContent.bookmarked) { %>
                <input type="hidden" name="add" value="false" />
                <button type="submit">
                  <img src="/icons/star_full.svg" class="w-12 h-12" alt="" />
                </button>
                <% } else { %>
                <input type="hidden" name="add" value="true" />
                <button type="submit">
                  <img src="/icons/star.svg" class="w-12 h-12" alt="" />
                </button>
                <% } %>
              </form>
            </div>
            <p class="text-gray-700 leading-relaxed mb-6">
              <%= moduleContent.body %>
            </p>

            <% if (moduleContent.video_path) { %>
            <div
              class="h-96 w-full rounded-lg overflow-hidden mb-4 shadow-md border border-gray-100"
            >
              <iframe
                src="<%= moduleContent.video_path.replace('youtu.be/', 'www.youtube.com/embed/').split('?')[0] %>"
                class="w-full h-full rounded-lg"
                allow="autoplay"
                frameborder="0"
                allowfullscreen
              ></iframe>
            </div>
            <% } %>
          </div>
        </div>
      </div>

      <!-- Action bar -->
      <div
        class="bg-mainGreen mx-auto w-full p-4 sticky bottom-0 z-50 shadow-lg"
      >
        <div class="flex items-center justify-between">
          <!-- Feedback buttons -->
          <div class="flex space-x-3">
            <form action="/feedback/update" method="POST" class="inline">
              <input type="hidden" name="type" value="true" />
              <input
                type="hidden"
                name="contentId"
                value="<%= moduleContent.id %>"
              />
              <input type="hidden" name="userId" value="<%= user.id %>" />
              <button
                type="submit"
                class="bg-white/10 hover:bg-white/20 p-2 rounded-full transition-colors flex items-center justify-center h-10 w-10 relative"
              >
                <img src="/icons/thumb_up.svg" alt="Like" />
                <span
                  class="absolute -top-2 -right-2 bg-green-500 text-white text-xs font-bold rounded-full h-5 w-5 flex items-center justify-center"
                  ><%=moduleContent.positiveFeedback %></span
                >
              </button>
            </form>
            <form action="/feedback/update" method="POST" class="inline">
              <input type="hidden" name="type" value="false" />
              <input
                type="hidden"
                name="contentId"
                value="<%= moduleContent.id %>"
              />
              <input type="hidden" name="userId" value="<%= user.id %>" />
              <button
                type="submit"
                class="bg-white/10 hover:bg-white/20 p-2 rounded-full transition-colors flex items-center justify-center h-10 w-10 relative"
              >
                <img src="/icons/thumb_down.svg" alt="Dislike" />
                <span
                  class="absolute -top-2 -right-2 bg-red-500 text-white text-xs font-bold rounded-full h-5 w-5 flex items-center justify-center"
                  ><%=moduleContent.negativeFeedback %></span
                >
              </button>
            </form>
          </div>

          <!-- Navigation buttons -->
          <div class="flex space-x-4">
            <% if ((moduleContent.content_order + 1) > modulePages.length) { %>
            <button
              class="rounded-lg bg-blue-500 hover:bg-blue-600 transition-colors shadow-sm"
            >
              <a
                href="/test"
                class="text-white p-3 px-8 md:px-12 font-medium inline-flex items-center"
              >
                PRÓXIMO (PROVA)
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="h-5 w-5 ml-2"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M9 5l7 7-7 7"
                  />
                </svg>
              </a>
            </button>
            <% } else { %>
            <!-- Next button -->
            <button
              class="rounded-lg bg-blue-500 hover:bg-blue-600 transition-colors shadow-sm"
            >
              <a
                href="/path/<%= pathId %>/module/1/page/<%= moduleContent.content_order + 1 %>"
                class="text-white p-3 px-8 md:px-12 font-medium inline-flex items-center"
              >
                PRÓXIMO
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="h-5 w-5 ml-2"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M9 5l7 7-7 7"
                  />
                </svg>
              </a>
            </button>
            <% } %>
          </div>
        </div>
      </div>
    </div>

    <!-- Rodapé  -->
    <%- include('./partials/footer') %>
  </body>
</html>
