<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Importa o arquivo de estilos CSS -->
    <link href="/css/style.css" rel="stylesheet" />
    <!-- Título da página exibido na aba do navegador -->
    <title>Grupo 05</title>
  </head>
  <body>
    <!-- Cabeçalho  -->
    <%- include('./partials/header') %>

    <div class="mt-16">
      <div class="bg-mainGreen h-20 rounded-e-xl w-3/6 flex items-center mb-8">
        <h1 class="text-white ms-8 text-3xl font-bold"><%= module.title %></h1>
      </div>

      <div class="flex flex-row justify-between mb-12">
        <!-- Botões para avançar lição -->
        <div
          class="bg-mainGreen/25 mt-8 ms-8 w-3/12 rounded-lg flex justify-center h-1/2 p-4"
        >
          <div class="rounded-lg w-1/2 grid gap-6 justify-items-center">
            <% modulePages.forEach(page => { %>

            <div class="rounded-lg bg-mainGreen w-full">
              <a
                href="/path/<%= pathId %>/module/1/page/<%= page.content_order %>"
              >
                <% if (page.content_order === moduleContent.content_order) { %>
                <p class="text-white p-2 text-center font-semibold text-xl">
                  Lição #<%= page.content_order %> (ATUAL) <% } else { %>
                </p>

                <p class="text-white p-2 text-center font-medium text-xl">
                  Lição #<%= page.content_order %> <% } %>
                </p></a
              >
            </div>

            <% }) %>
          </div>
        </div>
        <!-- Conteúdo da lição -->
        <div
          class="mt-8 me-8 w-7/12 rounded-lg flex flex-col items-start h-1/2"
        >
          <div class="w-full">
            <h1 class="text-2xl font-bold"><%= moduleContent.title %></h1>
            <p><%= moduleContent.body %></p>

                <% if (moduleContent.video_path) { %>
                <div class="h-60 w-full rounded-lg overflow-hidden mb-4">
                  <iframe
                    src="<%= moduleContent.video_path.replace('youtu.be/', 'www.youtube.com/embed/').split('?')[0] %>"
                    class="w-full h-full rounded-lg"
                    allow="autoplay"
                    frameborder="0"
                    allowfullscreen
                  ></iframe>
                </div>

            <% } %>
          </div>
        </div>
      </div>
      <div class="absolute end-0 bg-mainGreen w-2/6 p-3 rounded-s-lg">
        <div class="flex flex-row">
          <a href="/path/<%= pathId %>/module/1/page/1">
            <img src="/icons/thumb_up.svg" class="ms-4" alt="" />
          </a>
          <a href="/path/<%= pathId %>/module/1/page/1">
            <img src="/icons/thumb_down.svg" class="ms-4" alt="" />
          </a>
          <% if ((moduleContent.content_order + 1) > modulePages.length) { %>
          <button class="rounded-lg bg-blue-400 ms-auto me-4">
            <a href="/test" class="text-white p-3 ps-12 pe-12"
              >HORA DA PROVA!</a
            >
          </button>
          <% } else { %>
          <button class="rounded-lg bg-blue-400 ms-auto me-4">
            <a
              href="/path/<%= pathId %>/module/1/page/<%= moduleContent.content_order + 1 %>"
              class="text-white p-3 ps-12 pe-12"
              >PRÓXIMO</a
            >
          </button>
         <!-- Favoritar -->
          <form action="/bookmarks/add" method="POST">
          <input type="hidden" name="contentId" value="<%= moduleContent.id %>" />
          <button type="submit" class="rounded-lg bg-yellow-400 text-white p-3 px-6 hover:bg-yellow-500">
          Favoritar
          </button>
           <% } %>
        </form>
        </div>
      </div>
      <div class="mb-40"></div>
    </div>

    <!-- Rodapé  -->
    <%- include('./partials/footer') %>
  </body>
</html>
