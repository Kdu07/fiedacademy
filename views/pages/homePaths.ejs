<!-- rotas para cada trilha -->
 <div class="grid grid-cols-1 gap-4">
  <% trilhas.forEach(trilha => { %>
    <a href="/trilha/<%= trilha.id %>" class="block p-4 bg-green-100 rounded shadow hover:bg-green-200">
      <h2 class="text-xl font-bold text-green-800"><%= trilha.nome %></h2>
    </a>
  <% }) %>
</div>
