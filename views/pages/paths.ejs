<%
// MOCK LOCAL para teste sem backend:
const trilha = {
  nome: "Pulverização",
  modulos: [
    { id: 1, titulo: "Mapas e Dados", progresso: 10 },
    { id: 2, titulo: "Planejamento", progresso: 0 },
    { id: 3, titulo: "Aplicação", progresso: 0 },
    { id: 4, titulo: "AAA", progresso: 0 }
  ]
};

const trilha2 = {
  nome: "Básico",
  modulos: [
    { id: 1, titulo: "Mapas e Dados", progresso: 10 },
    { id: 2, titulo: "Planejamento", progresso: 0 },
    { id: 3, titulo: "Aplicação", progresso: 0 },
    { id: 4, titulo: "AAA", progresso: 0 }
  ]
};

const trilha3 = {
  nome: "Básico",
  modulos: [
    { id: 1, titulo: "Mapas e Dados", progresso: 10 },
    { id: 2, titulo: "Planejamento", progresso: 0 },
    { id: 3, titulo: "Aplicação", progresso: 0 },
    { id: 4, titulo: "AAA", progresso: 0 }
  ]
};
%>

<!-- views/pages/paths.ejs -->
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= trilha.nome %> | Trilha Onboarding </title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-white font-sans text-gray-800">

  <!-- Trilhas -->
  <div class="min-h-screen p-6 max-w-4xl mx-auto">
    <h1 class="text-3xl font-bold text-green-800 mb-8">Trilha: <%= trilha.nome %></h1>

    <!-- Módulos -->
    <% trilha.modulos.forEach((modulo, index) => { %>
      <div class="border rounded-xl p-5 mb-6 shadow-md">
        <h2 class="text-xl font-semibold text-green-800 mb-2">Módulo <%= index + 1 %> - <%= modulo.titulo %></h2>

        <!-- Barra de progresso -->
        <div class="w-full h-3 bg-gray-200 rounded-full mb-4">
          <div class="h-full bg-cyan-400 rounded-full" style="width: <%= modulo.progresso %>%;"></div>
        </div>

        <!-- Botão -->
        <a href="/conteudo/<%= modulo.id %>" class="bg-lime-200 hover:bg-lime-300 text-black px-4 py-2 rounded shadow flex items-center gap-2 w-fit">
          <%= modulo.progresso > 0 ? "Continuar" : "Iniciar" %> <span>→</span>
        </a>
      </div>
    <% }) %>
  </div>

</body>
</html>

