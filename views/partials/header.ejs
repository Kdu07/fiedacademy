<header
  class="fixed top-0 left-0 w-full h-20 bg-mainGreen shadow-md z-50"
>
  <div class="flex items-center justify-between h-full px-4">
    <div class="flex items-center justify-start gap-4 h-full">
      <%- include('./menu.ejs') %>
      <a
        href="<%= user.id === null ? '/' : '/home' %>"
        class="flex flex-row items-center"
      >
        <img
          src="/images/logo.png"
          alt="Logo Field Academy"
          class="h-14 w-auto cursor-pointer"
        />
        <p class="text-white text-2xl font-bold ml-2 hidden md:block">
          FieldAcademy
        </p>
      </a>
    </div>

    <div class="px-4">
      <% if (user.id === null) { %>
      <a
        href="/login"
        class="bg-white text-mainGreen px-6 py-2 rounded-full font-semibold hover:bg-gray-100 transition-all duration-200 flex items-center shadow-md hover:shadow-lg transform hover:-translate-y-0.5"
      >
        Login
      </a>
      <% } else { %>
      <a href="/profile/<%= user.id %>" class="block">
        <div
          class="w-14 h-14 rounded-full border-2 border-white overflow-hidden hover:border-white hover:shadow-glow transition-all duration-200 transform hover:scale-105"
        >
          <% if (user.profile_photo_path && user.profile_photo_path.trim() !==
          '') { %>
          <img
            src="<%= user.profile_photo_path %>"
            class="w-full h-full object-cover"
            alt="Foto de perfil"
            crossorigin="anonymous"
          />
          <% } else { %>
          <div class="w-full h-full bg-white flex items-center justify-center">
            <span class="text-lg font-semibold text-mainGreen">
              <%= user.name ? user.name.charAt(0).toUpperCase() : '?' %>
            </span>
          </div>
          <% } %>
        </div>
      </a>
      <% } %>
    </div>
  </div>
</header>

<!-- Espaçamento para o header fixo -->
<div class="w-full h-20"></div>

<style>
  .shadow-glow {
    box-shadow: 0 0 10px rgba(255, 255, 255, 0.7);
  }
</style>
