<header class="fixed top-0 left-0 w-full h-20 bg-mainGreen shadow-md z-50">
  <div class="flex items-center justify-between h-full px-4">
    <div class="flex items-center justify-start gap-4 h-full">
      <%- include('./menu.ejs') %>
      <a
        href="<%= user.id === null ? '/' : '/home' %>"
        class="flex flex-row items-center"
      >
        <img
          src="/images/logo.png"
          alt="Logo Field Academy"
          class="hidden md:block h-14 w-14 cursor-pointer"
        />
        <p class="text-white text-2xl font-bold ml-2 hidden md:block">
          FieldAcademy
        </p>
      </a>
    </div>

    <!-- Search Bar -->
    <div class="md:flex md:flex-grow max-w-sm md:max-w-lg">
      <form
        id="searchForm"
        class="w-full"
        onsubmit="event.preventDefault(); const query = this.querySelector('input').value.trim(); if(query) window.location.href='/search/q='+encodeURIComponent(query);"
      >
        <div class="relative w-full">
          <input
            type="text"
            placeholder="Search..."
            class="w-full bg-white py-2 px-4 pr-10 rounded-full border-2 border-white bg-transparent text-black placeholder-gray-400 focus:outline-none"
            value="<%= typeof query !== 'undefined' ? query : '' %>"
          />
          <button
            type="submit"
            class="absolute right-3 top-1/2 transform -translate-y-1/2 text-white"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-5 w-5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="#000000"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
              />
            </svg>
          </button>
        </div>
      </form>
    </div>

    <div class="px-4">
      <% if (user.id === null) { %>
      <a
        href="/login"
        class="bg-white text-mainGreen px-6 py-2 rounded-full font-semibold flex items-center shadow-md"
      >
        Login
      </a>
      <% } else { %>
      <a href="/profile/<%= user.id %>" class="hidden md:block">
        <div
          class="w-14 h-14 rounded-full border-2 border-white overflow-hidden"
        >
          <% if (user.profile_photo_path && user.profile_photo_path.trim() !==
          '') { %>
          <img
            src="<%= user.profile_photo_path %>"
            class="w-full h-full object-cover"
            alt="Foto de perfil"
            crossorigin="anonymous"
          />
          <% } else { %>
          <div class="w-full h-full bg-white flex items-center justify-center">
            <span class="text-lg font-semibold text-mainGreen">
              <%= user.name ? user.name.charAt(0).toUpperCase() : '?' %>
            </span>
          </div>
          <% } %>
        </div>
      </a>
      <% } %>
    </div>
  </div>
</header>

<!-- Espaçamento para o header fixo -->
<div class="w-full h-20 spacing-header"></div>

