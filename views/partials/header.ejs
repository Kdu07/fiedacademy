<header
  id=""
  class="fixed top-0 left-0 w-full h-20 bg-mainGreen z-50"
>
  <div class="flex items-center justify-start px-4 gap-4 h-full">
    <%- include('./menu.ejs') %>
    
    <a href="/" class="flex flex-row items-center">
      <img src="/images/logo.png" alt="Logo Field Academy" class="h-20 w-auto cursor-pointer"
      >
      <p class="text-white text-2xl font-bold ml-2 hidden md:block"> 
        FieldAcademy
      </p>
    </a>

    <!-- Barra de pesquisa -->
    <div
      class="flex items-center bg-gray-100 rounded-lg px-4 py-2 w-1/2 max-w-3xl"
    >
      <!-- Ícone de busca -->
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-5 w-5 text-black mr-2"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M21 21l-4.35-4.35m0 0A7.5 7.5 0 1111.5 4.5a7.5 7.5 0 015.15 12.15z"
        />
      </svg>
      <input
        type="text"
        placeholder="Busque aqui"
        class="bg-transparent outline-none placeholder-gray-500 text-black"
      />
    </div>

</header>
<!-- Espaço pq o header agora é fixo -->
<div class="w-full h-20"></div>