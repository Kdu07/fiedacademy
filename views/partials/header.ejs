<header id="" class="fixed top-0 left-0 w-full h-20 bg-mainGreen z-50">
  <div class="flex items-center justify-between h-full">
    <div class="flex items-center justify-start px-4 gap-4 h-full">
      <%- include('./menu.ejs') %>

      <a href="/" class="flex flex-row items-center">
        <img
          src="/images/logo.png"
          alt="Logo Field Academy"
          class="h-20 w-auto cursor-pointer"
        />
        <p class="text-white text-2xl font-bold ml-2 hidden md:block">
          FieldAcademy
        </p>
      </a>
    </div>
    <% if (user.id === null) {%>
    <div class="px-4">
      <a
        href="/login"
        class="bg-white text-mainGreen px-6 py-2 rounded-md font-semibold hover:bg-gray-100 transition-colors duration-200 flex items-center"
      >
        Login
      </a>
    </div>
    <% } %>
  </div>
</header>
<!-- Espaço pq o header agora é fixo -->
<div class="w-full h-20"></div>
