<div class="bg-login-bg h-full w-full fixed bg-cover flex flex-col">
  <div class="h-2/6"></div>
  <div class="h-4/6 bg-white/75 flex justify-center">
    <div class="flex flex-col items-center h-5/6 mt-auto">
      <h1 class="text-4xl font-semibold">Login</h1>
      <p class="text-gray-600 mt-4 mb-2">Se é bayer, é bom</p>
      <form action="/api/login-user" class="flex flex-col" method="POST">
        <input
          type="email"
          name="email"
          id="email"
          class="rounded-lg border-black border-2 bg-transparent w-full md:w-96 h-12 mt-4 px-4 placeholder-black"
          placeholder="Email"
          required
        />
        <input
          type="password"
          name="password"
          id="password"
          class="rounded-lg border-black border-2 bg-transparent w-full md:w-96 h-12 mt-4 px-4 placeholder-black"
          placeholder="Senha"
          required
        />
        <% if(error) { %>
        <p class="text-red-500 text-sm mt-2" id="errorMessage"><%= error %></p>
        <% } %>
        <button
          type="submit"
          class="rounded-lg bg-mainGreen w-full md:w-96 h-12 mt-4 px-4"
        >
          <p class="text-white">Entrar</p>
        </button>
      </form>
    </div>
  </div>
</div>
