<% if(user.id !== null) { %>
<div>
  <!-- Ícone de menu -->
  <button aria-label="Menu" onclick="toggleMenu()" id="menu-btn">
    <!-- Hamburger icon -->
    <svg
      id="icon-menu"
      xmlns="http://www.w3.org/2000/svg"
      class="h-6 w-6 text-white block"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M4 6h16M4 12h16M4 18h16"
      />
    </svg>
    <!-- X icon -->
    <svg
      id="icon-x"
      xmlns="http://www.w3.org/2000/svg"
      class="h-6 w-6 text-white hidden"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M6 18L18 6M6 6l12 12"
      />
    </svg>
  </button>

  <!-- Font Awesome CDN Link -->
  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
  />

  <div
    id="menu"
    class="fixed top-20 left-0 h-[calc(100vh-5rem)] w-full md:w-1/6 z-20 bg-gradient-to-b from-white to-gray-50 shadow-lg transform -translate-x-full transition-transform duration-300"
  >
    <div class="flex flex-col h-full gap-2 py-6 px-4">
      <a
        class="flex items-center gap-3 text-2xl md:text-xl p-3 rounded-lg hover:bg-gray-100 transition-all duration-200"
        href="/home"
      >
        <i class="fas fa-home text-secondaryGreen"></i>
        <span>Home</span>
      </a>
      <a
        class="flex items-center gap-3 text-2xl md:text-xl p-3 rounded-lg hover:bg-gray-100 transition-all duration-200"
        href="/profile/<%= user.id %>"
      >
        <i class="fas fa-user text-secondaryGreen"></i>
        <span>Perfil</span>
      </a>
      <a
        class="flex items-center gap-3 text-2xl md:text-xl p-3 rounded-lg hover:bg-gray-100 transition-all duration-200"
        href="/help"
      >
        <i class="fas fa-question-circle text-secondaryGreen"></i>
        <span>Help</span>
      </a>
      <% if (user.id_role !== 4) { %>
      <a
        class="flex items-center gap-3 text-2xl md:text-xl p-3 rounded-lg hover:bg-gray-100 transition-all duration-200"
        href="/dashboard"
      >
        <i class="fas fa-chart-line text-secondaryGreen"></i>
        <span>Dashboard</span>
      </a>
      <a
        class="flex items-center gap-3 text-2xl md:text-xl p-3 rounded-lg hover:bg-gray-100 transition-all duration-200"
        href="/create-user"
      >
        <i class="fas fa-user-plus text-secondaryGreen"></i>
        <span>Criar Usuário</span>
      </a>
      <% }%>
      <div class="flex-grow"></div>
      <a
        class="flex items-center gap-3 text-2xl md:text-xl p-3 mt-auto text-red-500 rounded-lg hover:bg-red-50 transition-all duration-200"
        href="/logout-user"
        onclick="return confirm('Você tem certeza que quer sair?')"
      >
        <i class="fas fa-sign-out-alt"></i>
        <span>Logout</span>
      </a>
    </div>
  </div>

  <script>
    function toggleMenu() {
      const menu = document.getElementById("menu");
      const iconMenu = document.getElementById("icon-menu");
      const iconX = document.getElementById("icon-x");

      if (menu.classList.contains("-translate-x-full")) {
        menu.classList.remove("-translate-x-full");
        menu.classList.add("translate-x-0");
        iconMenu.classList.add("hidden");
        iconX.classList.remove("hidden");
      } else {
        menu.classList.add("-translate-x-full");
        menu.classList.remove("translate-x-0");
        iconMenu.classList.remove("hidden");
        iconX.classList.add("hidden");
      }
    }
  </script>
</div>
<% } %>
