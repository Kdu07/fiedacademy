<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= path.title %> | Trilha</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <%- include('./partials/header') %>
  <div class="min-h-screen p-6 max-w-4xl mx-auto">
    <h1 class="text-3xl font-bold text-green-800 mb-8">Trilha: <%= path.title %></h1>
    <p class="mb-8"><%= path.description %></p>

    <% if (path.modules && path.modules.length) { %>
      <% path.modules.forEach((modulo, index) => { %>
        <div class="border rounded-xl p-5 mb-6 shadow-md">
          <h2 class="text-xl font-semibold text-green-800 mb-2">
            Módulo <%= index + 1 %> - <%= modulo.title %>
          </h2>
        </div>
      <% }) %>
    <% } else { %>
      <p>Nenhum módulo encontrado para esta trilha.</p>
    <% } %>
  </div>
  <%- include('./partials/footer') %>
</body>
</html>