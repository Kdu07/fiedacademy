<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= paths.title %> | FieldAcademy</title>
    <link href="/css/style.css" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <body class="bg-gray-50">
    <!-- Header -->
    <%- include('./partials/header') %>

    <div class="mt-16">
      <div
        class="bg-secondaryGreen h-28 w-full flex items-center mb-8 shadow-md"
      >
        <h1 class="text-white ms-8 text-3xl font-bold">
          <%= paths.title %>
        </h1>
      </div>

      <div class="container mx-auto px-4 py-4 max-w-5xl">
        <!-- Módulos -->
        <div class="space-y-6">
          <% paths.modules .sort((a, b) => a.order - b.order) .forEach((modulo,
          index) => { %>
          <!-- Módulo Card -->
          <div class="bg-white rounded-xl shadow-md overflow-hidden">
            <div class="border-b border-gray-100 px-6 py-4">
              <h2 class="text-xl font-semibold text-black">
                Módulo <%= index + 1 %> - <%= modulo.title %>
              </h2>
            </div>
            <div class="px-6 py-4">
              <!-- Barra de progresso -->
              <div
                class="w-full h-4 bg-gray-100 rounded-full mb-6 overflow-hidden"
              >
              <% console.log(modulo) %>
                <div
                  class="h-full bg-secondaryGreen  rounded-full transition-all duration-500"
                  style="width: <%= modulo.progress %>%"
                ></div>
              </div>
              <div class="flex justify-between items-center">
                <span class="text-sm text-gray-600 font-medium"
                  ><%= modulo.progress %>% concluído</span
                >
                <!-- Botão de continuar -->
                <a
                  href="/path/<%= currentPath %>/module/<%= modulo.id %>/page/1"
                  class="bg-secondaryGreen hover:bg-secondaryGreen/90 text-white px-6 py-2 rounded-lg shadow-sm transition-colors flex items-center gap-2"
                >
                  <%= modulo.progress > 0 ? "Continuar" : "Iniciar" %>
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-5 w-5"
                    viewBox="0 0 20 20"
                    fill="currentColor"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z"
                      clip-rule="evenodd"
                    />
                  </svg>
                </a>
              </div>
            </div>
          </div>
          <% }) %>
        </div>
      </div>
    </div>

    <!-- Footer -->
    <%- include('./partials/footer') %>
  </body>
</html>
