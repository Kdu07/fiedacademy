<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link href="/css/style.css" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="icon" type="image/x-icon" href="/images/favicon.ico" />
    <title>Perfil | FieldAcademy</title>
  </head>
  <body class="bg-gray-50">
    <!-- Header -->
    <%- include('./partials/header') %>

    <div class="mt-16">
      <div
        class="bg-secondaryGreen h-20 rounded-e-xl w-2/6 flex items-center mb-8 shadow-md"
      >
        <h1 class="text-white ms-8 text-3xl font-bold">Perfil</h1>
      </div>

      <div class="container mx-auto px-4 py-4 max-w-5xl">
        <!-- Profile Header -->
        <div class="bg-white rounded-xl shadow-md p-6 mb-6">
          <div class="flex flex-col md:flex-row items-start md:items-center">
            <div
              class="w-24 h-24 rounded-full border-2 border-secondaryGreen flex items-center justify-center mr-6 relative group hover:bg-gray-100 transition-colors duration-200"
            >
              <% if (userProfile.profile_photo_path &&
              userProfile.profile_photo_path.trim() !== '') { %>
              <img
                src="<%= userProfile.profile_photo_path %>"
                class="w-full h-full rounded-full object-cover"
                alt="<%= userProfile.name %>'s profile picture"
                crossorigin="anonymous"
              />
              <% } else { %>
              <div
                class="w-full h-full rounded-full bg-gray-200 flex items-center justify-center"
              >
                <span class="text-3xl font-semibold text-gray-600"
                  ><%= userProfile.name.charAt(0).toUpperCase() %></span
                >
              </div>
              <% } %>
              <!-- Hidden file input -->
              <% if (userProfile.id === user.id) { %>
              <form
                id="avatar-form"
                action="/profile/<%= userProfile.id %>/uploadPicture"
                method="POST"
                enctype="multipart/form-data"
                class="absolute inset-0 m-auto w-full h-full flex items-center justify-center"
              >
                <input
                  type="file"
                  name="avatar"
                  id="avatar-input"
                  accept="image/*"
                  class="hidden"
                  onchange="this.form.submit()"
                />
                <label
                  for="avatar-input"
                  class="absolute inset-0 m-auto w-10 h-10 opacity-0 group-hover:opacity-100 transition-opacity duration-200 cursor-pointer flex items-center justify-center bg-black/50 rounded-full"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-5 w-5 text-white"
                    viewBox="0 0 20 20"
                    fill="currentColor"
                  >
                    <path
                      d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zM11.379 5.793L3 14.172V17h2.828l8.38-8.379-2.83-2.828z"
                    />
                  </svg>
                </label>
              </form>
              <% } %>
            </div>

            <div class="flex flex-col mt-4 md:mt-0">
              <h1 class="text-3xl font-bold text-gray-800">
                <%- userProfile.name %>
              </h1>
              <div class="text-gray-600 mt-1"><%- userProfile.email %></div>
              <div class="mt-2">
                <span
                  class="px-3 py-1 bg-blue-100 text-blue-800 text-sm font-medium rounded-full"
                >
                  <%- userProfile.region %>
                </span>
              </div>
            </div>
          </div>
        </div>

        <!-- Stats Cards -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mb-6">
          <!-- Last Login -->
          <div class="bg-white rounded-xl shadow-md overflow-hidden">
            <div class="border-b border-gray-100 px-6 py-4">
              <h3 class="font-semibold text-gray-800">Último Acesso</h3>
            </div>
            <div class="px-6 py-6 flex items-center">
              <div class="bg-blue-100 p-3 rounded-full mr-4">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="h-6 w-6 text-blue-600"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
                  />
                </svg>
              </div>
              <div>
                <p class="text-xl font-semibold text-gray-800">
                  <%- lastLogin %>
                </p>
                <p class="text-sm text-gray-500">Data de acesso</p>
              </div>
            </div>
          </div>

          <!-- Last Module -->
          <div class="bg-white rounded-xl shadow-md overflow-hidden">
            <div class="border-b border-gray-100 px-6 py-4">
              <h3 class="font-semibold text-gray-800">Última Lição</h3>
            </div>
            <div class="px-6 py-6 flex items-center">
              <div class="bg-green-100 p-3 rounded-full mr-4">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="h-6 w-6 text-green-600"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"
                  />
                </svg>
              </div>
              <div>
                <p class="text-xl font-semibold text-gray-800">
                  <%= lastLesson.title %>
                </p>
                <p class="text-sm text-gray-500">Em andamento</p>
              </div>
            </div>
          </div>

          <!-- Average Score -->
          <div class="bg-white rounded-xl shadow-md overflow-hidden">
            <div class="border-b border-gray-100 px-6 py-4">
              <h3 class="font-semibold text-gray-800">Pontuação Total</h3>
            </div>
            <div class="px-6 py-6 flex items-center">
              <div class="bg-yellow-100 p-3 rounded-full mr-4">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="h-6 w-6 text-yellow-600"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"
                  />
                </svg>
              </div>
              <div>
                <p class="text-xl font-semibold text-gray-800">
                  <%- userProfile.score %>
                </p>
                <p class="text-sm text-gray-500">Pontos</p>
              </div>
            </div>
          </div>

          <!-- Rank Position -->
          <div class="bg-white rounded-xl shadow-md overflow-hidden">
            <div class="border-b border-gray-100 px-6 py-4">
              <h3 class="font-semibold text-gray-800">Posição no Rank</h3>
            </div>
            <div class="px-6 py-6 flex items-center">
              <div class="bg-purple-100 p-3 rounded-full mr-4">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="h-6 w-6 text-purple-600"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"
                  />
                </svg>
              </div>
              <div>
                <p class="text-xl font-semibold text-gray-800">
                  <%- userRank %>
                </p>
                <p class="text-sm text-gray-500">Entre todos os usuários</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Learning Paths -->
        <div class="bg-white rounded-xl shadow-md p-6 mb-6">
          <h2
            class="text-xl font-bold text-secondaryGreen mb-6 pb-2 border-b border-gray-100"
          >
            Trilhas de Aprendizagem
          </h2>

          <% if(progress.length === 0) { %>
          <p class="text-center text-gray-500 py-6">Nenhuma trilha iniciada</p>
          <% } else { %>
          <div class="space-y-6">
            <% progress.forEach((trilha) => { %>
            <div
              class="flex flex-col md:flex-row md:items-center justify-between"
            >
              <div class="mb-2 md:mb-0 md:w-1/4">
                <p class="text-lg font-medium text-gray-800">
                  <%- trilha.path_title %>
                </p>
                <span class="text-sm font-medium text-secondaryGreen"
                  ><%- trilha.progress_percentage %>% concluído</span
                >
              </div>
              <div
                class="w-full md:w-2/3 h-4 bg-gray-100 rounded-full overflow-hidden"
              >
                <div
                  class="h-full bg-secondaryGreen rounded-full transition-all duration-500"
                  style="width: <%- trilha.progress_percentage %>%"
                ></div>
              </div>

              <% if (userProfile.id === user.id && trilha.progress_percentage
              === 100) { %>
              <a
                href="/profile/<%= userProfile.id %>/path/<%= trilha.path_id %>/generateCertificate"
                class="mt-2 md:mt-0 md:ml-4 p-2 bg-gray-100 hover:bg-gray-200 rounded-full transition-colors"
                title="Baixar certificado"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="h-5 w-5 text-gray-600"
                  viewBox="0 0 20 20"
                  fill="currentColor"
                >
                  <path
                    fill-rule="evenodd"
                    d="M3 17a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm3.293-7.707a1 1 0 011.414 0L9 10.586V3a1 1 0 112 0v7.586l1.293-1.293a1 1 0 111.414 1.414l-3 3a1 1 0 01-1.414 0l-3-3a1 1 0 010-1.414z"
                    clip-rule="evenodd"
                  />
                </svg>
              </a>
              <% } %>
            </div>
            <% }) %>
          </div>
          <% } %>
        </div>

        <!-- Module Scores -->
        <div class="bg-white rounded-xl shadow-md p-6">
          <h2
            class="text-xl font-bold text-secondaryGreen mb-6 pb-2 border-b border-gray-100"
          >
            Notas dos Módulos
          </h2>

          <% if(moduleScores.length === 0) { %>
          <p class="text-center text-gray-500 py-6">Nenhum módulo concluído</p>
          <% } else { %>
          <div class="mt-6">
            <!-- Scale line with integrated markers -->
            <div class="relative w-full md:w-3/4 ml-auto mb-6">
              <!-- Scale line -->
              <div class="w-full h-px bg-gray-300"></div>

              <!-- Scale markers with proper positioning -->
              <div
                class="w-full absolute top-2 left-0 flex justify-between text-xs text-gray-500"
              >
                <% for(let i = 0; i <= 10; i++) { %>
                <div
                  class="relative"
                  style="left: <%= i === 0 ? '0%' : (i === 10 ? '0%' : '-5px') %>"
                >
                  <span><%= i * 10 %></span>
                  <% if(i < 10) { %>
                  <div
                    class="absolute -top-5 left-0 h-3 w-px bg-gray-300"
                  ></div>
                  <% } %>
                </div>
                <% } %>
              </div>
            </div>

            <!-- Module scores -->
            <div class="space-y-6">
              <% moduleScores.forEach((module) => { %>
              <div class="flex flex-col md:flex-row items-start">
                <div class="w-full md:w-1/4 mb-2 md:mb-0 md:pr-4">
                  <p class="text-sm font-medium text-gray-800">
                    <%- module.module_title %>
                  </p>
                  <p class="text-sm font-bold text-secondaryGreen">
                    <%- module.user_score %>/100
                  </p>
                </div>
                <div
                  class="relative w-full md:w-3/4 h-8 bg-gray-100 rounded-lg overflow-hidden"
                >
                  <div
                    class="absolute top-0 left-0 h-full bg-secondaryGreen rounded-lg transition-all duration-500"
                    style="width: <%= module.user_score %>%"
                  ></div>
                </div>
              </div>
              <% }); %>
            </div>
            <% } %>
          </div>
        </div>
      </div>
    </div>

    <!-- Footer -->
    <%- include('./partials/footer') %>
  </body>
</html>
