<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>
      Ajuda: <%= article ? article.title : 'Artigo de Ajuda' %> | FieldAcademy
    </title>
    <link href="/css/style.css" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com"></script>
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css"
    />
  </head>
  <body class="flex flex-col min-h-screen bg-gray-50">
    <!-- Header -->
    <%- include('./partials/header') %>

    <div class="mt-16">
      <div
        class="bg-secondaryGreen h-20 rounded-e-xl w-2/6 flex items-center mb-8 shadow-md"
      >
        <h1 class="text-white ms-8 text-3xl font-bold">
          <%= article ? article.category : 'Ajuda' %>
        </h1>
      </div>

      <div class="flex flex-row justify-between mb-16 px-6">
        <!-- Sidebar Navigation - Redesigned -->
        <div
          class="bg-white mt-8 ms-2 w-3/12 rounded-xl flex flex-col shadow-md border border-gray-100"
        >
          <h2
            class="bg-secondaryGreen text-white font-bold text-xl p-4 rounded-t-xl"
          >
            Tópicos de Ajuda
          </h2>
          <div
            class="p-4 overflow-y-auto max-h-[500px] scrollbar-thin scrollbar-thumb-gray-300 scrollbar-track-gray-100"
          >
            <!-- Current topic -->
            <% if (typeof article !== 'undefined') { %>
            <div class="mb-2 border-l-4 border-secondaryGreen pl-3 py-1">
              <a
                href="/help/<%= article.category %>/content/<%= article.id %>"
                class="text-secondaryGreen font-medium hover:underline flex items-center"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="h-4 w-4 mr-2"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M9 5l7 7-7 7"
                  />
                </svg>
                <%= article.title %>
              </a>
            </div>
            <% } %> <%  const categoriesMap = {};
            if (typeof allArticles !== 'undefined' &&
            Array.isArray(allArticles)) { allArticles.forEach(function(article)
            { if (!categoriesMap[article.category]) {
            categoriesMap[article.category] = []; }
            categoriesMap[article.category].push(article); }); } Object.keys(categoriesMap).forEach(function(category)
            { %>
            <div class="mt-4">
              <h3
                class="font-semibold text-gray-700 mb-2 text-sm uppercase tracking-wider"
              >
                <%= category %>
              </h3>
              <ul class="space-y-1 ml-2">
                <% categoriesMap[category].forEach(function(article) { const isCurrentArticle =
                typeof currentArticle !== 'undefined' && currentArticle &&
                currentArticle.id === article.id; %>
                <li>
                  <a
                    href="/help/<%= article.category %>/content/<%= article.id %>"
                    class="<%= isCurrentArticle ? 'text-secondaryGreen font-medium' : 'text-gray-600' %> hover:text-secondaryGreen block py-1"
                  >
                    <%= article.title %>
                  </a>
                </li>
                <% }); %>
              </ul>
            </div>
            <% }); %> <% if (typeof allArticles === 'undefined' ||
            !Array.isArray(allArticles) || allArticles.length === 0) { %>
            <div class="mt-4 text-center text-gray-500">
              Nenhum tópico de ajuda disponível.
            </div>
            <% } %>
          </div>
        </div>

        <!-- Article Content -->
        <div class="mt-8 me-2 w-7/12 rounded-lg flex flex-col items-start">
          <div class="w-full bg-white p-6 rounded-lg shadow-md">
            <div
              class="flex justify-between items-center mb-4 pb-2 border-b border-gray-100"
            >
              <h1 class="text-2xl font-bold text-gray-800">
                <%= article ? article.title : 'Artigo' %>
              </h1>
            </div>

            <div class="prose max-w-none text-gray-700 leading-relaxed mb-6">
              <%= article.body %>
            </div>

            <% if (article.video_path) { %>
            <div
              class="h-96 w-full rounded-lg overflow-hidden mb-4 shadow-md border border-gray-100"
            >
              <iframe
                src="<%= article.video_path.replace('youtu.be/', 'www.youtube.com/embed/').split('?')[0] %>"
                class="w-full h-full rounded-lg"
                allow="autoplay"
                frameborder="0"
                allowfullscreen
              ></iframe>
            </div>
            <% } %>

            <!-- Article feedback section (moved from bottom) -->
            <div class="border-t border-gray-200 pt-4 mt-4">
              <h3 class="text-gray-700 font-medium mb-3">
                Este artigo foi útil?
              </h3>
              <div class="flex items-center space-x-4">
                <form action="/feedback/update" method="POST" class="inline">
                  <input type="hidden" name="type" value="true" />
                  <input
                    type="hidden"
                    name="contentId"
                    value="<%= article ? article.id : 1 %>"
                  />
                  <input type="hidden" name="userId" value="<%= user.id %>" />
                  <button
                    type="submit"
                    class="bg-secondaryGreen/70 hover:bg-secondaryGreen p-2 rounded-lg transition-colors flex items-center space-x-2 px-4"
                  >
                    <img src="/icons/thumb_up.svg" alt="Like" class="h-5 w-5" />
                    <span class="text-sm text-gray-700"
                      >Sim (<%= article && article.positiveFeedback ?
                      article.positiveFeedback : 0 %>)</span
                    >
                  </button>
                </form>
                <form action="/feedback/update" method="POST" class="inline">
                  <input type="hidden" name="type" value="false" />
                  <input
                    type="hidden"
                    name="contentId"
                    value="<%= article ? article.id : 1 %>"
                  />
                  <input type="hidden" name="userId" value="<%= user.id %>" />
                  <button
                    type="submit"
                    class="bg-red-500/70 hover:bg-red-500 p-2 rounded-lg transition-colors flex items-center space-x-2 px-4"
                  >
                    <img
                      src="/icons/thumb_down.svg"
                      alt="Dislike"
                      class="h-5 w-5"
                    />
                    <span class="text-sm text-gray-700"
                      >Não (<%= article && article.negativeFeedback ?
                      article.negativeFeedback : 0 %>)</span
                    >
                  </button>
                </form>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Footer -->
    <%- include('./partials/footer') %>
  </body>
</html>
