<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Test Submitted | FieldAcademy</title>
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body class="bg-gray-50">
    <%- include('./partials/header') %>

    <div class="mt-16">
      <div
        class="bg-secondaryGreen h-20 rounded-e-xl w-2/6 flex items-center mb-8 shadow-md"
      >
        <h1 class="text-white ms-8 text-3xl font-bold">Avaliação Concluída</h1>
      </div>

      <div class="max-w-3xl mx-auto px-4 py-8">
        <div
          class="bg-white rounded-xl shadow-md p-8 mb-8 border border-gray-100"
        >
          <div class="flex flex-col items-center mb-6">
            <div
              class="w-20 h-20 bg-green-100 rounded-full flex items-center justify-center mb-4"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-10 w-10 text-green-600"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M5 13l4 4L19 7"
                />
              </svg>
            </div>
            <h2 class="text-2xl font-bold text-gray-800 mb-2">
              Avaliação Enviada com Sucesso!
            </h2>
            <p class="text-gray-600 text-center">
              Parabéns por completar a avaliação.
            </p>
          </div>

          <div class="border-t border-b border-gray-100 py-6 mb-6">
            <h3 class="text-xl font-bold text-secondaryGreen mb-4">
              Detalhes da Avaliação
            </h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div class="flex flex-col">
                <span class="text-gray-500 text-sm">Avaliação:</span>
                <span class="font-medium"><%= testTitle %></span>
              </div>
              <div class="flex flex-col">
                <span class="text-gray-500 text-sm">Aluno:</span>
                <span class="font-medium"><%= user.name %></span>
              </div>
              <div class="flex flex-col">
                <span class="text-gray-500 text-sm">Pontos Obtidos:</span>
                <span class="font-medium text-lg text-green-600"
                  ><%= earnedPoints %> pontos</span
                >
              </div>
              <div class="flex flex-col">
                <span class="text-gray-500 text-sm">Data de Envio:</span>
                <span class="font-medium"
                  ><%= new Date().toLocaleDateString('pt-BR') %></span
                >
              </div>
            </div>
          </div>

          <!-- New section for questions summary -->
          <div class="border-b border-gray-100 py-6 mb-6">
            <h3 class="text-xl font-bold text-secondaryGreen mb-4">
              Resumo das Questões
            </h3>

            <div class="space-y-6">
              <% questions.forEach((question, index) => { %>
              <div
                class="p-4 rounded-lg border <%= question.answeredCorrectly ? 'bg-green-50 border-green-100' : 'bg-red-50 border-red-100' %>"
              >
                <div class="flex items-start gap-3">
                  <div class="mt-1">
                    <% if(question.answeredCorrectly) { %>
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      class="h-5 w-5 text-green-600"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M5 13l4 4L19 7"
                      />
                    </svg>
                    <% } else { %>
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      class="h-5 w-5 text-red-600"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M6 18L18 6M6 6l12 12"
                      />
                    </svg>
                    <% } %>
                  </div>
                  <div class="flex-1">
                    <div class="font-medium mb-2">
                      <%= index + 1 %>. <%= question.text %>
                    </div>

                    <% if (question.options && question.options.length > 0) { %>
                    <div class="ml-4 mt-2 space-y-1">
                      <% question.options.forEach((option, optIndex) => { const
                      optionLetter = String.fromCharCode(97 + optIndex); const
                      isUserChoice = question.userAnswer === optionLetter; const
                      isCorrectOption = question.correctAnswer === optionLetter;
                      %>

                      <div
                        class="<%= isUserChoice ? (isCorrectOption ? 'text-green-700 font-medium' : 'text-red-700 font-medium') : (isCorrectOption ? 'text-green-700 font-medium' : '') %>"
                      >
                        <%= optionLetter %>) <%= option.text %> <% if(isUserChoice) {
                        %>
                        <span class="inline-block ml-2">[Sua resposta]</span>
                        <% } %> <% if(isCorrectOption && (!isUserChoice ||
                        !question.answeredCorrectly)) { %>
                        <span class="inline-block ml-2"
                          >[Resposta correta]</span
                        >
                        <% } %>
                      </div>
                      <% }); %>
                    </div>
                    <% } else if (typeof question.correctAnswer === 'boolean') {
                    %>
                    <div class="ml-4 mt-2 space-y-1">
                      <div
                        class="<%= question.userAnswer === true ? (question.correctAnswer === true ? 'text-green-700 font-medium' : 'text-red-700 font-medium') : '' %>"
                      >
                        Verdadeiro <% if(question.userAnswer === true) { %>
                        <span class="inline-block ml-2">[Sua resposta]</span>
                        <% } %> <% if(question.correctAnswer === true) { %>
                        <span class="inline-block ml-2"
                          >[Resposta correta]</span
                        >
                        <% } %>
                      </div>
                      <div
                        class="<%= question.userAnswer === false ? (question.correctAnswer === false ? 'text-green-700 font-medium' : 'text-red-700 font-medium') : '' %>"
                      >
                        Falso <% if(question.userAnswer === false) { %>
                        <span class="inline-block ml-2">[Sua resposta]</span>
                        <% } %> <% if(question.correctAnswer === false) { %>
                        <span class="inline-block ml-2"
                          >[Resposta correta]</span
                        >
                        <% } %>
                      </div>
                    </div>
                    <% } %>
                  </div>
                </div>
              </div>
              <% }); %>
            </div>
          </div>

          <div
            class="flex flex-col md:flex-row justify-between items-center gap-4"
          >
            <p class="text-gray-600">
              Seus resultados foram registrados no sistema.
            </p>
            <div class="flex gap-4">
              <a
                href="/"
                class="px-6 py-3 bg-secondaryGreen hover:bg-green-700 text-white rounded-lg font-medium transition-colors"
              >
                Voltar a página inicial
              </a>
            </div>
          </div>
        </div>

        <div class="bg-blue-50 rounded-lg p-6 border border-blue-100">
          <h3 class="font-bold text-blue-800 mb-2">O que fazer agora?</h3>
          <ul class="text-blue-700 space-y-2">
            <li class="flex items-start">
              <span class="mr-2">•</span>
              <span
                >Revise o material relacionado à avaliação para reforçar seu
                aprendizado</span
              >
            </li>
            <li class="flex items-start">
              <span class="mr-2">•</span>
              <span>Prossiga para o próximo módulo do curso</span>
            </li>
            <li class="flex items-start">
              <span class="mr-2">•</span>
              <span
                >Entre em contato com seu gestor ou outro PTD mais experiente se
                tiver dúvidas sobre o conteúdo</span
              >
            </li>
          </ul>
        </div>
      </div>
    </div>

    <%- include('./partials/footer') %>
  </body>
</html>
